//+------------------------------------------------------------------+
//|                                                            2.mq5 |
//+------------------------------------------------------------------+
#property version   "2.50"
#property strict

//--- Existing DLL sender (unchanged)
#import "egg.dll"
int SendLatestJson();
int PollResponses(string pathParameter, uchar &output[], int outputCapacity);
#import

input string InpGatewayClientId = "mt5_terminal_01";

#define GATEWAY_FEED_FILE     "LLM-LQ/mt5_feed.json"
#define GATEWAY_REQUEST_FILE  "LLM-LQ/Gateway/temp/current_request.json"
#define GATEWAY_SEQUENCE_FILE "LLM-LQ/Gateway/temp/request_sequence.txt"
#define GATEWAY_STATE_FILE    "LLM-LQ/Gateway/temp/current_state.txt"
#define GATEWAY_RESPONSE_FILE "LLM-LQ/Gateway/temp/current_response.json"


#include <JAson.mqh>

#include "Common.mqh"
#include "MovingAverages.mqh"
#include "Structure.mqh"

#include "MA_RIVER\\MaRiverObserver.mqh"

#include "MA_BOX\\FractalGeometry.mqh"
#include "MA_BOX\\FlatZoneSmallBoxObserver.mqh"

#include "MA_INERTIA\\RainBowDynamics.mqh"
#include "MA_INERTIA\\ZigZagEngine.mqh"
#include "MA_INERTIA\\MABifurcation.mqh"
#include "MA_INERTIA\\ZigZagAdvisor.mqh"


//+------------------------------------------------------------------+
//| Configuration                                                    |
//+------------------------------------------------------------------+
#define H1_HISTORY_CAPACITY 100
#define H6_HISTORY_CAPACITY 20


//+------------------------------------------------------------------+
//| Global objects                                                    |
//+------------------------------------------------------------------+
CMovingAverages g_ma_h1;
CMovingAverages g_ma_h6;

CMaRiver H1_river;
CMaRiver H6_river;

CMABifurcation mabif_h1;
CMABifurcation mabif_h6;

CJAVal json;

uchar response[16384];

string h1Candles = "";
string h6Candles = "";

string g_gatewayClientId = "";
string g_gatewayRequestId = "";

CStructure        m_stc;
CFractalGeometry  m_fractal;
   
//+------------------------------------------------------------------+
//| Expert initialization function                                   |
//+------------------------------------------------------------------+
int OnInit()
{



   MqlRates h1Rates[];
   MqlRates h6Rates[];

   ArraySetAsSeries(h1Rates, true);
   ArraySetAsSeries(h6Rates, true);

   int h1Copied = CopyRates(
      _Symbol,
      PERIOD_H1,
      1,
      H1_HISTORY_CAPACITY,
      h1Rates
   );
   if(h1Copied <= 0)
   {
      Print("[INIT] H1 CopyRates failed. copied=", h1Copied);
      return INIT_FAILED;
   }
   int h6Copied = CopyRates(
      _Symbol,
      PERIOD_H6,
      1,
      H6_HISTORY_CAPACITY,
      h6Rates
   );
   if(h6Copied <= 0)
   {
      Print("[INIT] H6 CopyRates failed. copied=", h6Copied);
      return INIT_FAILED;
   }
   if(!g_ma_h1.Init(7, 14, PERIOD_H1))
   {
      Print("[INIT] H1 MA initialization failed.");
      return INIT_FAILED;
   }

   if(!g_ma_h6.Init(42, 84, PERIOD_H6))
   {
      Print("[INIT] H6 MA initialization failed.");
      return INIT_FAILED;
   }

   // Structure
   m_stc.Init();
   g_ma_h1.Update();
   g_ma_h6.Update();

   m_fractal.Set(m_stc,g_ma_h1);
   
   m_stc.Update(300);
   H1_river.Set(g_ma_h1);
   H6_river.Set(g_ma_h6);
   
   m_fractal.Build();
   
   
   
   for(int i = h1Copied - 1; i > 0; i--)
   {
      H1_river.Update(i);
      int dir = mabif_h1.AddPoint( H1_river.Center() );

      if(h1Candles != "")
      h1Candles += ",";
      
      h1Candles += BuildCandleObject(
         h1Rates[i],
         H1_river.Center(),
         H1_river.Width(),
         dir
      );
   
   }
   
      
   string data = "{";   
   
   data += "\"H1\":{";
   data += "\"candles\":[" + h1Candles + "]";
   data += "}";
   
   data += "}";
        
   

   int result = 0;
   
   if(FileIsExist(GATEWAY_REQUEST_FILE, FILE_COMMON))
   {
      if(!GatewayLoadPendingRequest(
         g_gatewayClientId,
         g_gatewayRequestId
      ))
      {
         Print("[GATEWAY] Cannot recover pending request.");
         return INIT_FAILED;
      }
   
      if(FileIsExist(GATEWAY_RESPONSE_FILE, FILE_COMMON))
      {
         if(!GatewayValidateSavedResponse(
            g_gatewayClientId,
            g_gatewayRequestId
         ))
         {
            Print("[GATEWAY] Saved response does not match pending request.");
            return INIT_FAILED;
         }
   
         Print("[GATEWAY] Valid final response already persisted.");
      }
      else
      {
         // Retry همان Envelope ذخیره‌شده
         result = GatewaySubmit(data);
      }
   }
   else
   {
      if(FileIsExist(GATEWAY_RESPONSE_FILE, FILE_COMMON))
      {
         Print("[GATEWAY] Orphan response file exists. Manual reconciliation required.");
         return INIT_FAILED;
      }
   
      result = GatewaySubmit(data);
   
      if(!GatewayLoadPendingRequest(
         g_gatewayClientId,
         g_gatewayRequestId
      ))
      {
         Print("[GATEWAY] Cannot load newly created request.");
         return INIT_FAILED;
      }
   }




   Print("[GATEWAY] Submit result: ", result);
   
   EventSetTimer(3);
   
   return(INIT_SUCCEEDED);
}

void OnTick()
{




   
}
//+------------------------------------------------------------------+

void OnTimer()
{
   if(g_gatewayClientId == "" ||
      g_gatewayRequestId == "")
      return;

   // فقط پاسخ نهایی معتبر متعلق به درخواست جاری، Poll را متوقف می‌کند.
   if(FileIsExist(GATEWAY_RESPONSE_FILE, FILE_COMMON))
   {
      if(GatewayValidateSavedResponse(
         g_gatewayClientId,
         g_gatewayRequestId
      ))
         return;
   
      Print("[GATEWAY] Saved response is invalid; continuing Poll.");
   }

   string state;

   if(!GatewayLoadState(state))
      return;

   // تا وقتی ارسال موفق نشده، Poll نکن.
   if(state != "SENT" &&
      state != "REGISTERED" &&
      state != "PROCESSING")
      return;

   if(!GatewayPollAndPersist(
      g_gatewayClientId,
      g_gatewayRequestId
   ))
   {
      Print("[GATEWAY] Poll attempt failed; will retry.");
   }
}

void OnDeinit(const int reason)
{
   EventKillTimer();
}



//+------------------------------------------------------------------+
//| Direction to text                                                 |
//+------------------------------------------------------------------+
string DirectionText(const int direction)
{
   if(direction == 1)
      return "UP";

   if(direction == -1)
      return "DOWN";

   return "UNKNOWN";
}


//+------------------------------------------------------------------+
//| Build one candle JSON object                                     |
//+------------------------------------------------------------------+
string BuildCandleObject(
   const MqlRates &bar,
   const double riverCenter,
   const double riverWidth,
   const int direction
)
{
   string timeStr = TimeToString(
      bar.time,
      TIME_DATE | TIME_MINUTES
   );

   string data = "{";

   data += "\"time\":\"" + timeStr + "\",";
   data += "\"open\":" + DoubleToString(bar.open, _Digits) + ",";
   data += "\"high\":" + DoubleToString(bar.high, _Digits) + ",";
   data += "\"low\":" + DoubleToString(bar.low, _Digits) + ",";
   data += "\"close\":" + DoubleToString(bar.close, _Digits) + ",";

   data += "\"tick_volume\":" + IntegerToString((long)bar.tick_volume) + ",";
   data += "\"spread_points\":" + IntegerToString(bar.spread) + ",";

   data += "\"river_center\":" + DoubleToString(riverCenter, _Digits) + ",";
   data += "\"river_width_pips\":" + DoubleToString(riverWidth, 2) + ",";

   data += "\"ma_bifurcation\":{";
   data += "\"direction\":\"" + DirectionText(direction) + "\"";
   data += "}";

   data += "}";

   return data;
}


//---------------------------------------------------------
// Escape کردن رشته برای قرار گرفتن در JSON
//---------------------------------------------------------
string GatewayJsonEscape(string value)
{
   StringReplace(value, "\\", "\\\\");
   StringReplace(value, "\"", "\\\"");
   StringReplace(value, "\r", "\\r");
   StringReplace(value, "\n", "\\n");
   StringReplace(value, "\t", "\\t");

   return value;
}

//---------------------------------------------------------
// زمان UTC با قالب ISO-8601
//---------------------------------------------------------
string GatewayUtcNow()
{
   MqlDateTime t;
   TimeToStruct(TimeGMT(), t);

   return StringFormat(
      "%04d-%02d-%02dT%02d:%02d:%02dZ",
      t.year, t.mon, t.day,
      t.hour, t.min, t.sec
   );
}

//---------------------------------------------------------
// ذخیره وضعیت فعلی
//---------------------------------------------------------
bool GatewaySaveState(const string state)
{
   int h = FileOpen(
      GATEWAY_STATE_FILE,
      FILE_WRITE | FILE_TXT | FILE_COMMON | FILE_ANSI
   );

   if(h == INVALID_HANDLE)
      return false;

   FileWriteString(h, state);
   FileClose(h);

   return true;
}

bool GatewayLoadState(string &state)
{
   state = "";

   if(!FileIsExist(GATEWAY_STATE_FILE, FILE_COMMON))
      return false;

   int h = FileOpen(
      GATEWAY_STATE_FILE,
      FILE_READ | FILE_TXT | FILE_COMMON | FILE_ANSI
   );

   if(h == INVALID_HANDLE)
      return false;

   state = FileReadString(h);
   FileClose(h);

   return (state != "");
}


string GatewayNextRequestId()
{
   long sequence = 0;

   if(FileIsExist(GATEWAY_SEQUENCE_FILE, FILE_COMMON))
   {
      int h = FileOpen(
         GATEWAY_SEQUENCE_FILE,
         FILE_READ | FILE_TXT | FILE_COMMON | FILE_ANSI
      );

      if(h == INVALID_HANDLE)
         return "";

      string saved = FileReadString(h);
      FileClose(h);

      sequence = StringToInteger(saved);
   }

   sequence++;

   int h = FileOpen(
      GATEWAY_SEQUENCE_FILE,
      FILE_WRITE | FILE_TXT | FILE_COMMON | FILE_ANSI
   );

   if(h == INVALID_HANDLE)
      return "";

   FileWriteString(h, IntegerToString(sequence));
   FileClose(h);

   return InpGatewayClientId + "-" +
          StringFormat("%06d", sequence);
}



int GatewaySubmit(const string body)
{
   // بررسی اولیه: body باید یک JSON object باشد.
   // اعتبارسنجی کامل JSON باید قبل از ارسال انجام شود.
   string payload = body;
   StringTrimLeft(payload);
   StringTrimRight(payload);

   int bodyLength = StringLen(payload);

   if(bodyLength < 2 ||
      StringSubstr(payload, 0, 1) != "{" ||
      StringSubstr(payload, bodyLength - 1, 1) != "}")
   {
      Print("[GATEWAY] Invalid JSON object body.");
      return -200;
   }

   string envelope = "";

   // اگر درخواست حل‌نشده داریم، همان را بازیابی می‌کنیم.
   if(FileIsExist(GATEWAY_REQUEST_FILE, FILE_COMMON))
   {
      int h = FileOpen(
         GATEWAY_REQUEST_FILE,
         FILE_READ | FILE_TXT | FILE_COMMON | FILE_UNICODE
      );

      if(h == INVALID_HANDLE)
         return -201;

      envelope = FileReadString(h);
      FileClose(h);

      if(StringLen(envelope) == 0)
         return -202;

      Print("[GATEWAY] Existing request will be retried.");
   }
   else
   {
      // ساخت شناسه جدید
      string requestId = GatewayNextRequestId();

      if(requestId == "")
         return -203;

      string clientId = GatewayJsonEscape(InpGatewayClientId);
      string escapedRequestId = GatewayJsonEscape(requestId);
      string createdAt = GatewayUtcNow();

      // ساخت Envelope مطابق پروتکل
      envelope = "{";

      envelope += "\"protocol\":\"mt5-gateway\",";
      envelope += "\"version\":1,";
      envelope += "\"message_type\":\"INGEST\",";
      envelope += "\"client_id\":\"" + clientId + "\",";
      envelope += "\"request_id\":\"" + escapedRequestId + "\",";
      envelope += "\"created_at\":\"" + createdAt + "\",";
      envelope += "\"payload\":" + payload;

      envelope += "}";

      // ابتدا ذخیره پایدار درخواست
      int h = FileOpen(
         GATEWAY_REQUEST_FILE,
         FILE_WRITE | FILE_TXT | FILE_COMMON | FILE_UNICODE
      );

      if(h == INVALID_HANDLE)
         return -204;

      FileWriteString(h, envelope);
      FileClose(h);

      Print("[GATEWAY] Request persisted: ", requestId);
   }

   // ثبت وضعیت پیش از ارسال
   if(!GatewaySaveState("SENDING"))
      return -205;

   // تحویل Envelope به فایل ثابت مورد انتظار DLL
   int feedHandle = FileOpen(
      GATEWAY_FEED_FILE,
      FILE_WRITE | FILE_TXT | FILE_COMMON | FILE_UNICODE
   );

   if(feedHandle == INVALID_HANDLE)
      return -206;

   FileWriteString(feedHandle, envelope);
   FileClose(feedHandle);

   // DLL خودش فایل را می‌خواند و ارسال می‌کند
   int result = SendLatestJson();

   Print("[GATEWAY] SendLatestJson result: ", result);

   // تمام پاسخ‌های 2xx، از جمله 204، موفقیت انتقال هستند.
   if(result >= 200 && result < 300)
   {
      GatewaySaveState("SENT");
   }
   else
   {
      // درخواست و شناسه حفظ می‌شوند تا Retry با همان Envelope باشد.
      GatewaySaveState("SENDING");
   }

   return result;
}

//+------------------------------------------------------------------+
//| Execute HTTP GET through DLL and return UTF-8 response           |
//+------------------------------------------------------------------+
bool GatewayHttpGet(
   const string pathParameter,
   string &responseText
)
{
   responseText = "";

   ArrayInitialize(response, 0);

   int result = PollResponses(
      pathParameter,
      response,
      ArraySize(response)
   );

   if(result <= 0)
   {
      Print("[GATEWAY] GET failed. result=", result);
      return false;
   }

   responseText = CharArrayToString(
      response,
      0,
      WHOLE_ARRAY,
      CP_UTF8
   );

   if(StringLen(responseText) == 0)
   {
      Print("[GATEWAY] GET returned empty response. result=", result);
      return false;
   }

   return true;
}

//+------------------------------------------------------------------+
//| Poll one MT5 request                                             |
//+------------------------------------------------------------------+
bool GatewayPoll(
   const string clientId,
   const string requestId,
   string &responseText
)
{
   string path =
      "/gateway/mt5/responses"
      "?client_id=" + clientId +
      "&request_id=" + requestId;

   return GatewayHttpGet(path, responseText);
}

bool GatewayParsePollResponse(
   const string responseText,
   const string expectedClientId,
   const string expectedRequestId,
   string &status,
   string &responseId
)
{
   status = "";
   responseId = "";

   CJAVal pollJson;

   if(!pollJson.Deserialize(responseText))
   {
      Print("[GATEWAY] Invalid Poll JSON.");
      return false;
   }

   string protocol = pollJson["protocol"].ToStr();
   int version = (int)pollJson["version"].ToInt();
   string messageType = pollJson["message_type"].ToStr();
   string clientId = pollJson["client_id"].ToStr();
   string requestId = pollJson["request_id"].ToStr();

   if(protocol != "mt5-gateway" ||
      version != 1 ||
      messageType != "POLL_RESULT")
   {
      Print("[GATEWAY] Invalid Poll protocol envelope.");
      return false;
   }

   if(clientId != expectedClientId ||
      requestId != expectedRequestId)
   {
      Print("[GATEWAY] Poll response identity mismatch.");
      return false;
   }

   status = pollJson["status"].ToStr();
   responseId = pollJson["response_id"].ToStr();

   if(status != "PROCESSING" &&
      status != "COMPLETED" &&
      status != "FAILED")
   {
      Print("[GATEWAY] Unexpected Poll status: ", status);
      return false;
   }

   if((status == "COMPLETED" || status == "FAILED") &&
      responseId == "")
   {
      Print("[GATEWAY] Final response has no response_id.");
      return false;
   }

   Print("[GATEWAY] Poll validated. status=", status,
         " response_id=", responseId);

   return true;
}
bool GatewaySaveResponse(const string responseText)
{
   int h = FileOpen(
      GATEWAY_RESPONSE_FILE,
      FILE_WRITE | FILE_TXT | FILE_COMMON | FILE_UNICODE
   );

   if(h == INVALID_HANDLE)
   {
      Print("[GATEWAY] Cannot open response file. error=", GetLastError());
      return false;
   }

   uint written = FileWriteString(h, responseText);
   FileClose(h);

   if(written == 0)
   {
      Print("[GATEWAY] Failed to write response file.");
      return false;
   }

   Print("[GATEWAY] Response persisted.");
   return true;
}

bool GatewayPollAndPersist(
   const string clientId,
   const string requestId
)
{
   string responseText;
   string status;
   string responseId;

   if(!GatewayPoll(clientId, requestId, responseText))
      return false;

   if(!GatewayParsePollResponse(
      responseText,
      clientId,
      requestId,
      status,
      responseId
   ))
      return false;

   if(status == "PROCESSING")
      return true;

   if(!GatewaySaveResponse(responseText))
      return false;

   if(!GatewaySaveState("RESPONSE_RECEIVED"))
      return false;

   return true;
}


//+------------------------------------------------------------------+
//| Load and validate the persisted pending request                 |
//+------------------------------------------------------------------+
bool GatewayLoadPendingRequest(
   string &clientId,
   string &requestId
)
{
   clientId = "";
   requestId = "";

   if(!FileIsExist(GATEWAY_REQUEST_FILE, FILE_COMMON))
   {
      Print("[GATEWAY] No pending request file.");
      return false;
   }

   int h = FileOpen(
      GATEWAY_REQUEST_FILE,
      FILE_READ | FILE_TXT | FILE_COMMON | FILE_UNICODE
   );

   if(h == INVALID_HANDLE)
   {
      Print("[GATEWAY] Cannot open pending request. error=", GetLastError());
      return false;
   }

   string envelope = FileReadString(h);
   FileClose(h);

   if(StringLen(envelope) == 0)
   {
      Print("[GATEWAY] Pending request file is empty.");
      return false;
   }

   CJAVal requestJson;

   if(!requestJson.Deserialize(envelope))
   {
      Print("[GATEWAY] Pending request JSON is invalid.");
      return false;
   }

   string protocol = requestJson["protocol"].ToStr();
   int version = (int)requestJson["version"].ToInt();
   string messageType = requestJson["message_type"].ToStr();

   clientId = requestJson["client_id"].ToStr();
   requestId = requestJson["request_id"].ToStr();

   if(protocol != "mt5-gateway" ||
      version != 1 ||
      messageType != "INGEST")
   {
      Print("[GATEWAY] Invalid pending request envelope.");
      clientId = "";
      requestId = "";
      return false;
   }

   if(clientId == "" ||
      requestId == "" ||
      clientId != InpGatewayClientId)
   {
      Print("[GATEWAY] Pending request identity is invalid.");
      clientId = "";
      requestId = "";
      return false;
   }

   Print("[GATEWAY] Pending request recovered. request_id=", requestId);

   return true;
}

//+------------------------------------------------------------------+
//| Validate persisted final response against active request        |
//+------------------------------------------------------------------+
bool GatewayValidateSavedResponse(
   const string expectedClientId,
   const string expectedRequestId
)
{
   if(!FileIsExist(GATEWAY_RESPONSE_FILE, FILE_COMMON))
      return false;

   int h = FileOpen(
      GATEWAY_RESPONSE_FILE,
      FILE_READ | FILE_TXT | FILE_COMMON | FILE_UNICODE
   );

   if(h == INVALID_HANDLE)
   {
      Print("[GATEWAY] Cannot open saved response. error=", GetLastError());
      return false;
   }

   string responseText = FileReadString(h);
   FileClose(h);

   if(responseText == "")
      return false;

   string status;
   string responseId;

   if(!GatewayParsePollResponse(
      responseText,
      expectedClientId,
      expectedRequestId,
      status,
      responseId
   ))
      return false;

   if(status != "COMPLETED" && status != "FAILED")
   {
      Print("[GATEWAY] Saved response is not final. status=", status);
      return false;
   }

   Print("[GATEWAY] Saved final response validated. request_id=",
         expectedRequestId,
         " response_id=", responseId);

   return true;
}

