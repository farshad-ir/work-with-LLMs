//+------------------------------------------------------------------+
//| Gateway state machine                                            |
//+------------------------------------------------------------------+

enum GatewayState
{
   STATE_IDLE = 0,
   STATE_CREATED,
   STATE_SENDING,
   STATE_SENT,
   STATE_PROCESSING,
   STATE_RESPONSE_RECEIVED,
   STATE_ACK_SENDING,
   STATE_ACKNOWLEDGED,
   STATE_ERROR
};

enum GatewayEvent
{
   EVENT_NONE = 0,
   EVENT_START,
   EVENT_REQUEST_READY,
   EVENT_SEND_OK,
   EVENT_SEND_FAILED,
   EVENT_POLL_PROCESSING,
   EVENT_RESPONSE_COMPLETED,
   EVENT_RESPONSE_FAILED,
   EVENT_NETWORK_ERROR,
   EVENT_ACK_READY,
   EVENT_ACK_OK,
   EVENT_ACK_FAILED,
   EVENT_CLEANUP_OK,
   EVENT_CLEANUP_FAILED
};

// محدودیت اجرای چرخه
#define GATEWAY_MAX_STEPS          120
#define GATEWAY_MAX_SEND_ATTEMPTS  5
#define GATEWAY_MAX_POLL_ATTEMPTS  60
#define GATEWAY_MAX_ACK_ATTEMPTS   5
#define GATEWAY_SLEEP_SECONDS      1

string GatewayStateToText(const GatewayState state)
{
   switch(state)
   {
      case STATE_IDLE:             return "IDLE";
      case STATE_CREATED:          return "CREATED";
      case STATE_SENDING:          return "SENDING";
      case STATE_SENT:             return "SENT";
      case STATE_PROCESSING:       return "PROCESSING";
      case STATE_RESPONSE_RECEIVED:return "RESPONSE_RECEIVED";
      case STATE_ACK_SENDING:      return "ACK_SENDING";
      case STATE_ACKNOWLEDGED:     return "ACKNOWLEDGED";
      case STATE_ERROR:            return "ERROR";
   }

   return "ERROR";
}

bool GatewayTextToState(
   const string text,
   GatewayState &state
)
{
   if(text == "IDLE")              state = STATE_IDLE;
   else if(text == "CREATED")      state = STATE_CREATED;
   else if(text == "SENDING")      state = STATE_SENDING;
   else if(text == "SENT")         state = STATE_SENT;
   else if(text == "PROCESSING")   state = STATE_PROCESSING;
   else if(text == "RESPONSE_RECEIVED") state = STATE_RESPONSE_RECEIVED;
   else if(text == "ACK_SENDING")  state = STATE_ACK_SENDING;
   else if(text == "ACKNOWLEDGED") state = STATE_ACKNOWLEDGED;
   else if(text == "ERROR")        state = STATE_ERROR;
   else return false;

   return true;
}

bool GatewayTransition(
   const GatewayState currentState,
   const GatewayEvent event,
   GatewayState &nextState
)
{
   nextState = currentState;

   switch(currentState)
   {
      case STATE_IDLE:
         if(event == EVENT_START)
            nextState = STATE_CREATED;
         else
            return false;
         break;

      case STATE_CREATED:
         if(event == EVENT_REQUEST_READY)
            nextState = STATE_SENDING;
         else
            return false;
         break;

      case STATE_SENDING:
         if(event == EVENT_SEND_OK)
            nextState = STATE_SENT;
         else if(event == EVENT_SEND_FAILED ||
                 event == EVENT_NETWORK_ERROR)
            nextState = STATE_SENDING;
         else
            return false;
         break;

      case STATE_SENT:
         if(event == EVENT_POLL_PROCESSING)
            nextState = STATE_PROCESSING;
         else if(event == EVENT_RESPONSE_COMPLETED ||
                 event == EVENT_RESPONSE_FAILED)
            nextState = STATE_RESPONSE_RECEIVED;
         else if(event == EVENT_NETWORK_ERROR)
            nextState = STATE_SENT;
         else
            return false;
         break;

      case STATE_PROCESSING:
         if(event == EVENT_POLL_PROCESSING ||
            event == EVENT_NETWORK_ERROR)
            nextState = STATE_PROCESSING;
         else if(event == EVENT_RESPONSE_COMPLETED ||
                 event == EVENT_RESPONSE_FAILED)
            nextState = STATE_RESPONSE_RECEIVED;
         else
            return false;
         break;

      case STATE_RESPONSE_RECEIVED:
         if(event == EVENT_ACK_READY)
            nextState = STATE_ACK_SENDING;
         else
            return false;
         break;

      case STATE_ACK_SENDING:
         if(event == EVENT_ACK_OK)
            nextState = STATE_ACKNOWLEDGED;
         else if(event == EVENT_ACK_FAILED ||
                 event == EVENT_NETWORK_ERROR)
            nextState = STATE_ACK_SENDING;
         else
            return false;
         break;

      case STATE_ACKNOWLEDGED:
         if(event == EVENT_CLEANUP_OK)
            nextState = STATE_IDLE;
         else if(event == EVENT_CLEANUP_FAILED)
            nextState = STATE_ACKNOWLEDGED;
         else
            return false;
         break;

      case STATE_ERROR:
         return false;
   }

   return true;
}





CStructure        m_stc;
CFractalGeometry  m_fractal;
   
//+------------------------------------------------------------------+
//| Expert initialization function                                   |
//+------------------------------------------------------------------+
int OnInit()
{



   MqlRates h1Rates[];
   MqlRates h6Rates[];

   ArraySetAsSeries(h1Rates, true);
   ArraySetAsSeries(h6Rates, true);

   int h1Copied = CopyRates(
      _Symbol,
      PERIOD_H1,
      1,
      H1_HISTORY_CAPACITY,
      h1Rates
   );
   if(h1Copied <= 0)
   {
      Print("[INIT] H1 CopyRates failed. copied=", h1Copied);
      return INIT_FAILED;
   }
   int h6Copied = CopyRates(
      _Symbol,
      PERIOD_H6,
      1,
      H6_HISTORY_CAPACITY,
      h6Rates
   );
   if(h6Copied <= 0)
   {
      Print("[INIT] H6 CopyRates failed. copied=", h6Copied);
      return INIT_FAILED;
   }
   if(!g_ma_h1.Init(7, 14, PERIOD_H1))
   {
      Print("[INIT] H1 MA initialization failed.");
      return INIT_FAILED;
   }

   if(!g_ma_h6.Init(42, 84, PERIOD_H6))
   {
      Print("[INIT] H6 MA initialization failed.");
      return INIT_FAILED;
   }

   // Structure
   m_stc.Init();
   g_ma_h1.Update();
   g_ma_h6.Update();

   m_fractal.Set(m_stc,g_ma_h1);
   
   m_stc.Update(300);
   H1_river.Set(g_ma_h1);
   H6_river.Set(g_ma_h6);
   
   m_fractal.Build();
   
   
   
   for(int i = h1Copied - 1; i > 0; i--)
   {
      H1_river.Update(i);
      int dir = mabif_h1.AddPoint( H1_river.Center() );

      if(h1Candles != "")
      h1Candles += ",";
      
      h1Candles += BuildCandleObject(
         h1Rates[i],
         H1_river.Center(),
         H1_river.Width(),
         dir
      );
   
   }
   
      
   string data = "{";   
   
   data += "\"H1\":{";
   data += "\"candles\":[" + h1Candles + "]";
   data += "}";
   
   data += "}";

   g_gatewayClientId = InpGatewayClientId;

   if(!GatewayExecuteRequest(data))
   {
      Print("[GATEWAY] Request execution did not complete.");
      return INIT_FAILED;
   }

   Print("[GATEWAY] Request execution completed.");

   return INIT_SUCCEEDED;
}

