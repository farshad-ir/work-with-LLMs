//+------------------------------------------------------------------+
//| Configuration                                                    |
//+------------------------------------------------------------------+
#define H1_HISTORY_CAPACITY 100
#define H6_HISTORY_CAPACITY 20


//+------------------------------------------------------------------+
//| Global objects                                                    |
//+------------------------------------------------------------------+
CMovingAverages g_ma_h1;
CMovingAverages g_ma_h6;

CMaRiver H1_river;
CMaRiver H6_river;

CMABifurcation mabif_h1;
CMABifurcation mabif_h6;

CJAVal json;

uchar response[16384];

string h1Candles = "";
string h6Candles = "";
   
//+------------------------------------------------------------------+
//| Expert initialization function                                   |
//+------------------------------------------------------------------+
int OnInit()
{

   MqlRates h1Rates[];
   MqlRates h6Rates[];

   ArraySetAsSeries(h1Rates, true);
   ArraySetAsSeries(h6Rates, true);

   int h1Copied = CopyRates(
      _Symbol,
      PERIOD_H1,
      1,
      H1_HISTORY_CAPACITY,
      h1Rates
   );
   if(h1Copied <= 0)
   {
      Print("[INIT] H1 CopyRates failed. copied=", h1Copied);
      return INIT_FAILED;
   }
   int h6Copied = CopyRates(
      _Symbol,
      PERIOD_H6,
      1,
      H6_HISTORY_CAPACITY,
      h6Rates
   );
   if(h6Copied <= 0)
   {
      Print("[INIT] H6 CopyRates failed. copied=", h6Copied);
      return INIT_FAILED;
   }
   if(!g_ma_h1.Init(7, 14, PERIOD_H1))
   {
      Print("[INIT] H1 MA initialization failed.");
      return INIT_FAILED;
   }

   if(!g_ma_h6.Init(42, 84, PERIOD_H6))
   {
      Print("[INIT] H6 MA initialization failed.");
      return INIT_FAILED;
   }

   H1_river.Set(g_ma_h1);
   H6_river.Set(g_ma_h6);
   
   for(int i = h1Copied - 1; i >= 0; i--)
   {
      H1_river.Update(i);
      int dir = mabif_h1.AddPoint( H1_river.Center() );

      if(h1Candles != "")
      h1Candles += ",";
      
      h1Candles += BuildCandleObject(
         h1Rates[i],
         H1_river.Center(),
         H1_river.Width(),
         dir
      );
   
   }
   
      
   string data = "{";   
   
   data += "\"H1\":{";
   data += "\"candles\":[" + h1Candles + "]";
   data += "}";
   
   data += "}";
        
   


   int result = GatewaySubmit(data);
   
   Print("Result: ", result);
   
   return(INIT_SUCCEEDED);
}

void OnTick()
{




   
}
//+------------------------------------------------------------------+





//+------------------------------------------------------------------+
//| Direction to text                                                 |
//+------------------------------------------------------------------+
string DirectionText(const int direction)
{
   if(direction == 1)
      return "UP";

   if(direction == -1)
      return "DOWN";

   return "UNKNOWN";
}


//+------------------------------------------------------------------+
//| Build one candle JSON object                                     |
//+------------------------------------------------------------------+
string BuildCandleObject(
   const MqlRates &bar,
   const double riverCenter,
   const double riverWidth,
   const int direction
)
{
   string timeStr = TimeToString(
      bar.time,
      TIME_DATE | TIME_MINUTES
   );

   string data = "{";

   data += "\"time\":\"" + timeStr + "\",";
   data += "\"open\":" + DoubleToString(bar.open, _Digits) + ",";
   data += "\"high\":" + DoubleToString(bar.high, _Digits) + ",";
   data += "\"low\":" + DoubleToString(bar.low, _Digits) + ",";
   data += "\"close\":" + DoubleToString(bar.close, _Digits) + ",";

   data += "\"tick_volume\":" + IntegerToString((long)bar.tick_volume) + ",";
   data += "\"spread_points\":" + IntegerToString(bar.spread) + ",";

   data += "\"river_center\":" + DoubleToString(riverCenter, _Digits) + ",";
   data += "\"river_width_pips\":" + DoubleToString(riverWidth, 2) + ",";

   data += "\"ma_bifurcation\":{";
   data += "\"direction\":\"" + DirectionText(direction) + "\"";
   data += "}";

   data += "}";

   return data;
}


//---------------------------------------------------------
// Escape کردن رشته برای قرار گرفتن در JSON
//---------------------------------------------------------
string GatewayJsonEscape(string value)
{
   StringReplace(value, "\\", "\\\\");
   StringReplace(value, "\"", "\\\"");
   StringReplace(value, "\r", "\\r");
   StringReplace(value, "\n", "\\n");
   StringReplace(value, "\t", "\\t");

   return value;
}

//---------------------------------------------------------
// زمان UTC با قالب ISO-8601
//---------------------------------------------------------
string GatewayUtcNow()
{
   MqlDateTime t;
   TimeToStruct(TimeGMT(), t);

   return StringFormat(
      "%04d-%02d-%02dT%02d:%02d:%02dZ",
      t.year, t.mon, t.day,
      t.hour, t.min, t.sec
   );
}

//---------------------------------------------------------
// ذخیره وضعیت فعلی
//---------------------------------------------------------
bool GatewaySaveState(const string state)
{
   int h = FileOpen(
      GATEWAY_STATE_FILE,
      FILE_WRITE | FILE_TXT | FILE_COMMON | FILE_ANSI
   );

   if(h == INVALID_HANDLE)
      return false;

   FileWriteString(h, state);
   FileClose(h);

   return true;
}

string GatewayNextRequestId()
{
   long sequence = 0;

   if(FileIsExist(GATEWAY_SEQUENCE_FILE, FILE_COMMON))
   {
      int h = FileOpen(
         GATEWAY_SEQUENCE_FILE,
         FILE_READ | FILE_TXT | FILE_COMMON | FILE_ANSI
      );

      if(h == INVALID_HANDLE)
         return "";

      string saved = FileReadString(h);
      FileClose(h);

      sequence = StringToInteger(saved);
   }

   sequence++;

   int h = FileOpen(
      GATEWAY_SEQUENCE_FILE,
      FILE_WRITE | FILE_TXT | FILE_COMMON | FILE_ANSI
   );

   if(h == INVALID_HANDLE)
      return "";

   FileWriteString(h, IntegerToString(sequence));
   FileClose(h);

   return InpGatewayClientId + "-" +
          StringFormat("%06d", sequence);
}



int GatewaySubmit(const string body)
{
   // بررسی اولیه: body باید یک JSON object باشد.
   // اعتبارسنجی کامل JSON باید قبل از ارسال انجام شود.
   string payload = body;
   StringTrimLeft(payload);
   StringTrimRight(payload);

   int bodyLength = StringLen(payload);

   if(bodyLength < 2 ||
      StringSubstr(payload, 0, 1) != "{" ||
      StringSubstr(payload, bodyLength - 1, 1) != "}")
   {
      Print("[GATEWAY] Invalid JSON object body.");
      return -200;
   }

   string envelope = "";

   // اگر درخواست حل‌نشده داریم، همان را بازیابی می‌کنیم.
   if(FileIsExist(GATEWAY_REQUEST_FILE, FILE_COMMON))
   {
      int h = FileOpen(
         GATEWAY_REQUEST_FILE,
         FILE_READ | FILE_TXT | FILE_COMMON | FILE_UNICODE
      );

      if(h == INVALID_HANDLE)
         return -201;

      envelope = FileReadString(h);
      FileClose(h);

      if(StringLen(envelope) == 0)
         return -202;

      Print("[GATEWAY] Existing request will be retried.");
   }
   else
   {
      // ساخت شناسه جدید
      string requestId = GatewayNextRequestId();

      if(requestId == "")
         return -203;

      string clientId = GatewayJsonEscape(InpGatewayClientId);
      string escapedRequestId = GatewayJsonEscape(requestId);
      string createdAt = GatewayUtcNow();

      // ساخت Envelope مطابق پروتکل
      envelope = "{";

      envelope += "\"protocol\":\"mt5-gateway\",";
      envelope += "\"version\":1,";
      envelope += "\"message_type\":\"INGEST\",";
      envelope += "\"client_id\":\"" + clientId + "\",";
      envelope += "\"request_id\":\"" + escapedRequestId + "\",";
      envelope += "\"created_at\":\"" + createdAt + "\",";
      envelope += "\"payload\":" + payload;

      envelope += "}";

      // ابتدا ذخیره پایدار درخواست
      int h = FileOpen(
         GATEWAY_REQUEST_FILE,
         FILE_WRITE | FILE_TXT | FILE_COMMON | FILE_UNICODE
      );

      if(h == INVALID_HANDLE)
         return -204;

      FileWriteString(h, envelope);
      FileClose(h);

      Print("[GATEWAY] Request persisted: ", requestId);
   }

   // ثبت وضعیت پیش از ارسال
   if(!GatewaySaveState("SENDING"))
      return -205;

   // تحویل Envelope به فایل ثابت مورد انتظار DLL
   int feedHandle = FileOpen(
      GATEWAY_FEED_FILE,
      FILE_WRITE | FILE_TXT | FILE_COMMON | FILE_UNICODE
   );

   if(feedHandle == INVALID_HANDLE)
      return -206;

   FileWriteString(feedHandle, envelope);
   FileClose(feedHandle);

   // DLL خودش فایل را می‌خواند و ارسال می‌کند
   int result = SendLatestJson();

   Print("[GATEWAY] SendLatestJson result: ", result);

   // تمام پاسخ‌های 2xx، از جمله 204، موفقیت انتقال هستند.
   if(result >= 200 && result < 300)
   {
      GatewaySaveState("SENT");
   }
   else
   {
      // درخواست و شناسه حفظ می‌شوند تا Retry با همان Envelope باشد.
      GatewaySaveState("SENDING");
   }

   return result;
}


