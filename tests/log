<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Http\JsonResponse;
use Illuminate\Support\Facades\Log;
use Symfony\Component\HttpFoundation\StreamedResponse;

class GatewayController extends Controller
{
    public function codex(Request $request): StreamedResponse|JsonResponse
    {

        file_put_contents('/home/yhkcinki/rezvan/storage/logs/entry-test.txt', "بسلامت وارد شدیم\n", FILE_APPEND |LOCK_EX);

        $socket = null;


        $requestId = bin2hex(random_bytes(8));
        $stage = 'started';
        $startedAt = microtime(true);
        
        $diagPath = storage_path('logs/gateway-private.log');
        
        $writeLog = function (
            string $event,
            array $context = []
        ) use ($diagPath, $requestId, $startedAt): void {
        
            $elapsedMs = (int) round(
                (microtime(true) - $startedAt) * 1000
            );
        
            $contextText = $context
                ? ' | ' . json_encode(
                    $context,
                    JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
                )
                : '';
        
            $line = sprintf(
                "%s | request=%s | +%dms | %s%s\n",
                date('Y-m-d H:i:s'),
                $requestId,
                $elapsedMs,
                $event,
                $contextText
            );
        
            file_put_contents(
                $diagPath,
                $line,
                FILE_APPEND | LOCK_EX
            );
        };
        
        $writeLog('CODEX_CONTROLLER_ENTERED', [
            'method' => $request->method(),
            'path' => $request->path(),
            'client_ip' => $request->ip(),
        ]);





        try {
            $errno = 0;
            $errstr = '';

            $stage = 'connecting';

            $socket = @stream_socket_client(
                'tcp://127.0.0.1:8088',
                $errno,
                $errstr,
                15
            );

            if (!is_resource($socket)) {
                throw new \RuntimeException(
                    "Python gateway connection failed: {$errstr} ({$errno})"
                );
            }

            $stage = 'connected';

            $writeLog('PYTHON_CONNECTED');

            // Python sends heartbeat every 15 seconds.
            // Allow enough time for several heartbeat intervals.
            stream_set_timeout($socket, 0);
            
            $body = $request->getContent();
            
            $payload = json_decode(
                $body,
                false,
                512,
                JSON_THROW_ON_ERROR
            );
            
            if (!is_object($payload)) {
                throw new \RuntimeException(
                    'Invalid JSON request: expected a JSON object.'
                );
            }
            
            $clientStream = $payload->stream ?? null;
            
            // This endpoint is dedicated to streaming Codex responses.
            $payload->stream = true;
            
            $body = json_encode(
                $payload,
                JSON_UNESCAPED_UNICODE |
                JSON_UNESCAPED_SLASHES |
                JSON_THROW_ON_ERROR
            );
            
            $writeLog('REQUEST_STREAM_MODE', [
                'client_requested_stream' => $clientStream,
                'gateway_stream' => true,
                'body_bytes' => strlen($body),
            ]);
            
            $contentType = $request->header(
                'Content-Type',
                'application/json'
            );
            
            $accept = $request->header(
                'Accept',
                'application/json'
            );





            // Prevent header injection.
            $contentType = str_replace(["\r", "\n"], '', $contentType);
            $accept = str_replace(["\r", "\n"], '', $accept);

            $headers =
                "POST /v1/responses HTTP/1.1\r\n" .
                "Host: 127.0.0.1:8088\r\n" .
                "X-Gateway-Request-ID: {$requestId}\r\n" .
                "Content-Type: {$contentType}\r\n" .
                "Accept: {$accept}\r\n" .
                "Accept-Encoding: identity\r\n" .
                "Content-Length: " . strlen($body) . "\r\n" .
                "Connection: close\r\n" .
                "\r\n";

            $stage = 'sending';

            $this->writeAll($socket, $headers . $body);
            

            $stage = 'sent';
            
            $writeLog('REQUEST_SENT', [
                'bytes' => strlen($headers . $body),
            ]);
            
            $stage = 'waiting_status';
            
            $writeLog('WAITING_FOR_PYTHON_STATUS');
            
            $statusLine = fgets($socket, 8192);
            
            if ($statusLine === false) {
            
                $meta = stream_get_meta_data($socket);
            
                $writeLog('PYTHON_STATUS_READ_FAILED', [
                    'socket' => $meta,
                ]);
            
                throw new \RuntimeException(
                    'Could not read Python HTTP status line.'
                );
            }
            
            $writeLog('PYTHON_STATUS_LINE_RECEIVED', [
                'status_line' => trim($statusLine),
            ]);
            
            if (!preg_match(
                '/^HTTP\/\d(?:\.\d)?\s+(\d{3})/',
                $statusLine,
                $matches
            )) {
                throw new \RuntimeException(
                    'Invalid Python HTTP status line: ' .
                    trim($statusLine)
                );
            }
            
            $statusCode = (int) $matches[1];

            

            // Read upstream response headers.
            $upstreamHeaders = [];

            while (($line = fgets($socket, 8192)) !== false) {
                if ($line === "\r\n" || $line === "\n") {
                    break;
                }

                $separator = strpos($line, ':');

                if ($separator === false) {
                    continue;
                }

                $name = strtolower(trim(substr($line, 0, $separator)));
                $value = trim(substr($line, $separator + 1));

                $upstreamHeaders[$name] = $value;
            }

            // Handle an interim 100 Continue response, if one is returned.
            if ($statusCode === 100) {

                $statusLine = fgets($socket, 8192);

                if ($statusLine === false ||
                    !preg_match('/^HTTP\/\d(?:\.\d)?\s+(\d{3})/', $statusLine, $matches)) {
                    throw new \RuntimeException('Invalid final response from Python gateway.');
                }

                $statusCode = (int) $matches[1];
                $upstreamHeaders = [];

                while (($line = fgets($socket, 8192)) !== false) {
                    if ($line === "\r\n" || $line === "\n") {
                        break;
                    }

                    $separator = strpos($line, ':');

                    if ($separator === false) {
                        continue;
                    }

                    $name = strtolower(trim(substr($line, 0, $separator)));
                    $value = trim(substr($line, $separator + 1));

                    $upstreamHeaders[$name] = $value;
                }
            }
            $writeLog('PYTHON_HEADERS_RECEIVED');
            $writeLog('PYTHON_STATUS_RECEIVED: ' . $statusCode);

            $isChunked = isset($upstreamHeaders['transfer-encoding'])
                && stripos($upstreamHeaders['transfer-encoding'], 'chunked') !== false;
            $writeLog(
                'PYTHON_BODY_MODE: ' .
                ($isChunked ? 'chunked' : (isset($upstreamHeaders['content-length']) ? 'content-length' : 'connection-close'))
            );
            $responseHeaders = [
                'Content-Type' => $upstreamHeaders['content-type'] ?? 'application/json',
                'Cache-Control' => $upstreamHeaders['cache-control'] ?? 'no-cache',
                'X-Accel-Buffering' => 'no',
            ];

            if (!$isChunked && isset($upstreamHeaders['content-length'])) {
                $responseHeaders['Content-Length'] = $upstreamHeaders['content-length'];
            }

            if (isset($upstreamHeaders['retry-after'])) {
                $responseHeaders['Retry-After'] = $upstreamHeaders['retry-after'];
            }
            $writeLog('LARAVEL_STREAM_RESPONSE_CREATED');

            return response()->stream(
                function () use ($socket, $isChunked, $upstreamHeaders, $writeLog) {
                    @set_time_limit(0);
                    $writeLog('RESPONSE_STREAM_STARTED');

                    try {
                        if ($isChunked) {
                            $this->streamChunkedBody($socket, $writeLog);
                        } elseif (isset($upstreamHeaders['content-length'])) {
                            $remaining = (int) $upstreamHeaders['content-length'];

                            while ($remaining > 0) {
                                $chunk = fread($socket, min(8192, $remaining));

                                if ($chunk === false || $chunk === '') {
                                    break;
                                }

                                echo $chunk;
                                $remaining -= strlen($chunk);
                                $this->flushOutput();
                            }
                        } else {
                            while (!feof($socket)) {
                                $chunk = fread($socket, 8192);

                                if ($chunk === false || $chunk === '') {
                                    break;
                                }

                                echo $chunk;
                                $this->flushOutput();
                            }
                        }

                        $writeLog('RESPONSE_BODY_READ_ENDED');

                    } catch (\Throwable $e) {
                        $writeLog('RESPONSE_STREAM_ERROR: ' . $e->getMessage());
                        throw $e;
                    } finally {
                        $writeLog('RESPONSE_STREAM_CLOSED');
                    
                        if (is_resource($socket)) {
                            fclose($socket);
                        }
                    }
                },
                $statusCode,
                $responseHeaders
            );

        } catch (\Throwable $e) {

            $writeLog('GATEWAY_ERROR: ' . $stage . ' | ' . $e->getMessage());

            if (is_resource($socket)) {
                fclose($socket);
            }

            report($e);

            return response()->json([
                'error' => 'Gateway connection failed',
                'message' => 'Could not communicate with the Python gateway.',
            ], 502);
        }
    }

    private function writeAll($socket, string $data): void
    {
        $length = strlen($data);
        $written = 0;

        while ($written < $length) {
            $result = fwrite($socket, substr($data, $written));

            if ($result === false || $result === 0) {
                throw new \RuntimeException('Failed to write request to Python gateway.');
            }

            $written += $result;
        }
    }

    private function readExact($socket, int $length): string
    {
        $result = '';

        while (strlen($result) < $length) {
            $chunk = fread($socket, $length - strlen($result));

            if ($chunk === false || $chunk === '') {
                throw new \RuntimeException('Unexpected end of chunked response.');
            }

            $result .= $chunk;
        }

        return $result;
    }

    private function streamChunkedBody(
        $socket,
        callable $writeLog
    ): void {
    
        $chunkCount = 0;
        $totalBytes = 0;
        $heartbeatCount = 0;
    
        while (true) {
    
            $line = fgets($socket, 8192);
    
            if ($line === false) {
    
                $meta = stream_get_meta_data($socket);
    
                throw new \RuntimeException(
                    'Unexpected end of chunked response: ' .
                    json_encode($meta)
                );
            }
    
            $sizeText = trim(
                explode(';', trim($line), 2)[0]
            );
    
            if ($sizeText === '' || !ctype_xdigit($sizeText)) {
                throw new \RuntimeException(
                    'Invalid HTTP chunk size: ' . trim($line)
                );
            }
    
            $chunkSize = hexdec($sizeText);
    
            if ($chunkSize === 0) {
    
                $trailerComplete = false;
    
                while (($trailer = fgets($socket, 8192)) !== false) {
    
                    if ($trailer === "\r\n" || $trailer === "\n") {
                        $trailerComplete = true;
                        break;
                    }
                }
    
                if (!$trailerComplete) {
                    throw new \RuntimeException(
                        'Incomplete HTTP chunk trailer.'
                    );
                }
    
                break;
            }
    
            $chunk = $this->readExact($socket, $chunkSize);
    
            $chunkCount++;
            $totalBytes += strlen($chunk);
    
            if (str_contains($chunk, ': heartbeat')) {
    
                $heartbeatCount++;
    
                $writeLog('UPSTREAM_HEARTBEAT_RECEIVED', [
                    'heartbeat_count' => $heartbeatCount,
                    'chunk' => $chunkCount,
                ]);
            }
    
            echo $chunk;
            $this->flushOutput();
    
            $crlf = $this->readExact($socket, 2);
    
            if ($crlf !== "\r\n") {
                throw new \RuntimeException(
                    'Invalid HTTP chunk terminator.'
                );
            }
        }
    
        $writeLog('UPSTREAM_CHUNKED_BODY_COMPLETE', [
            'chunks' => $chunkCount,
            'bytes' => $totalBytes,
            'heartbeats' => $heartbeatCount,
        ]);
    }



    private function flushOutput(): void
    {
        if (ob_get_level() > 0) {
            @ob_flush();
        }

        flush();
    }

    public function mt5(Request $request): JsonResponse
    {
        return response()->json([
            'gateway' => 'Rezvan Gateway',
            'endpoint' => 'mt5',
            'status' => 'received',
            'input_keys' => array_keys($request->all()),
        ]);
    }
}
