<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Http\JsonResponse;
use Illuminate\Support\Facades\Log;
use Illuminate\Support\Facades\Http;
use Symfony\Component\HttpFoundation\StreamedResponse;

class GatewayController extends Controller
{
    public function codex(Request $request): StreamedResponse|JsonResponse
    {
        $internalToken = (string) env(
            'GATEWAY_RESPONSE_BUFFER_TOKEN',
            ''
        );

        if ($internalToken === '') {
            return response()->json([
                'error' => 'Gateway internal token is not configured.',
            ], 500);
        }


        $socket = null;


        $requestId = bin2hex(random_bytes(8));
        $stage = 'started';
        $startedAt = microtime(true);
        
        $diagPath = storage_path('logs/gateway-private.log');
        
        $writeLog = function (
            string $event,
            array $context = []
        ) use ($diagPath, $requestId, $startedAt): void {
        
            $elapsedMs = (int) round(
                (microtime(true) - $startedAt) * 1000
            );
        
            $contextText = $context
                ? ' | ' . json_encode(
                    $context,
                    JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES
                )
                : '';
        
            $line = sprintf(
                "%s | request=%s | +%dms | %s%s\n",
                date('Y-m-d H:i:s'),
                $requestId,
                $elapsedMs,
                $event,
                $contextText
            );
        
            file_put_contents(
                $diagPath,
                $line,
                FILE_APPEND | LOCK_EX
            );
        };
        
        $writeLog('CODEX_CONTROLLER_ENTERED', [
            'method' => $request->method(),
            'path' => $request->path(),
            'client_ip' => $request->ip(),
        ]);





        try {
            $errno = 0;
            $errstr = '';

            $stage = 'connecting';

            $socket = @stream_socket_client(
                'tcp://127.0.0.1:8088',
                $errno,
                $errstr,
                15
            );

            if (!is_resource($socket)) {
                throw new \RuntimeException(
                    "Python gateway connection failed: {$errstr} ({$errno})"
                );
            }

            $stage = 'connected';

            $writeLog('PYTHON_CONNECTED');

            // Python sends heartbeat every 15 seconds.
            // Allow enough time for several heartbeat intervals.
            stream_set_timeout($socket, 0);
            
            $body = $request->getContent();
            
            $payload = json_decode(
                $body,
                false,
                512,
                JSON_THROW_ON_ERROR
            );
            
            if (!is_object($payload)) {
                throw new \RuntimeException(
                    'Invalid JSON request: expected a JSON object.'
                );
            }
            
            $clientStream = $payload->stream ?? null;
            
            // This endpoint is dedicated to streaming Codex responses.
            $payload->stream = true;
            
            $body = json_encode(
                $payload,
                JSON_UNESCAPED_UNICODE |
                JSON_UNESCAPED_SLASHES |
                JSON_THROW_ON_ERROR
            );
            
            $writeLog('REQUEST_STREAM_MODE', [
                'client_requested_stream' => $clientStream,
                'gateway_stream' => true,
                'body_bytes' => strlen($body),
            ]);
            
            $contentType = $request->header(
                'Content-Type',
                'application/json'
            );
            
            $accept = $request->header(
                'Accept',
                'application/json'
            );





            // Prevent header injection.
            $contentType = str_replace(["\r", "\n"], '', $contentType);
            $accept = str_replace(["\r", "\n"], '', $accept);

            $headers =
                "POST /v1/responses HTTP/1.1\r\n" .
                "Host: 127.0.0.1:8088\r\n" .
                "X-Gateway-Request-ID: {$requestId}\r\n" .
                "Content-Type: {$contentType}\r\n" .
                "Accept: {$accept}\r\n" .
                "Accept-Encoding: identity\r\n" .
                "Content-Length: " . strlen($body) . "\r\n" .
                "Connection: close\r\n" .
                "\r\n";

            $stage = 'sending';

            $this->writeAll($socket, $headers . $body);
            

            $stage = 'sent';
            
            $writeLog('REQUEST_SENT', [
                'bytes' => strlen($headers . $body),
            ]);
            
            $stage = 'waiting_status';
            
            $writeLog('WAITING_FOR_PYTHON_STATUS');
            
            sleep(2);
            $statusLine = fgets($socket, 8192);
            
            if ($statusLine === false) {
            
                $meta = stream_get_meta_data($socket);
            
                $writeLog('PYTHON_STATUS_READ_FAILED', [
                    'socket' => $meta,
                ]);
            
                throw new \RuntimeException(
                    'Could not read Python HTTP status line.'
                );
            }
            
            $writeLog('PYTHON_STATUS_LINE_RECEIVED', [
                'status_line' => trim($statusLine),
            ]);
            
            if (!preg_match(
                '/^HTTP\/\d(?:\.\d)?\s+(\d{3})/',
                $statusLine,
                $matches
            )) {
                throw new \RuntimeException(
                    'Invalid Python HTTP status line: ' .
                    trim($statusLine)
                );
            }
            
            $statusCode = (int) $matches[1];

            

            // Read upstream response headers.
            $upstreamHeaders = [];

            while (($line = fgets($socket, 8192)) !== false) {
                if ($line === "\r\n" || $line === "\n") {
                    break;
                }

                $separator = strpos($line, ':');

                if ($separator === false) {
                    continue;
                }

                $name = strtolower(trim(substr($line, 0, $separator)));
                $value = trim(substr($line, $separator + 1));

                $upstreamHeaders[$name] = $value;
            }

            // Handle an interim 100 Continue response, if one is returned.
            if ($statusCode === 100) {

                $statusLine = fgets($socket, 8192);

                if ($statusLine === false ||
                    !preg_match('/^HTTP\/\d(?:\.\d)?\s+(\d{3})/', $statusLine, $matches)) {
                    throw new \RuntimeException('Invalid final response from Python gateway.');
                }

                $statusCode = (int) $matches[1];
                $upstreamHeaders = [];

                while (($line = fgets($socket, 8192)) !== false) {
                    if ($line === "\r\n" || $line === "\n") {
                        break;
                    }

                    $separator = strpos($line, ':');

                    if ($separator === false) {
                        continue;
                    }

                    $name = strtolower(trim(substr($line, 0, $separator)));
                    $value = trim(substr($line, $separator + 1));

                    $upstreamHeaders[$name] = $value;
                }
            }
            $writeLog('PYTHON_HEADERS_RECEIVED');
            $writeLog('PYTHON_STATUS_RECEIVED: ' . $statusCode);

            if ($statusCode === 202) {
                if (is_resource($socket)) {
                    fclose($socket);
                    $socket = null;
                }

                $writeLog('BUFFERED_REQUEST_ACCEPTED');
                return response()->stream(
                    function () use ($internalToken, $writeLog) {
                        @set_time_limit(0);

                        $writeLog('BUFFERED_SSE_STREAM_STARTED');

                        $sendHeartbeat = function () use ($writeLog) {
                            echo ": heartbeat\n\n";
                            $this->flushOutput();

                            $writeLog('CLIENT_HEARTBEAT_SENT');
                        };

                        $sentEventCount = 0;

                        try {
                            $bufferedResponse = $this->fetchBufferedResponse(
                                $internalToken,
                                $writeLog,
                                $sendHeartbeat
                            );

                            $events = $this->responsesToSseEvents(
                                $bufferedResponse
                            );

                            foreach ($events as $event) {
                                echo $event;
                                $this->flushOutput();
                                $sentEventCount++;
                            }

                            $writeLog('BUFFERED_SSE_DELIVERY_COMPLETED', [
                                'response_id' => $bufferedResponse['id'] ?? null,
                                'event_count' => count($events),
                            ]);

                        } catch (\Throwable $e) {
                            $writeLog('BUFFERED_SSE_DELIVERY_ERROR', [
                                'message' => $e->getMessage(),
                                'sent_event_count' => $sentEventCount,
                            ]);

                            $errorEvent = [
                                'type' => 'error',
                                'code' => 'buffered_response_failed',
                                'message' => 'Gateway response delivery failed.',
                                'param' => null,
                                'sequence_number' => $sentEventCount + 1,
                            ];

                            echo "event: error\n";
                            echo 'data: ' . json_encode(
                                $errorEvent,
                                JSON_UNESCAPED_UNICODE |
                                JSON_UNESCAPED_SLASHES |
                                JSON_THROW_ON_ERROR
                            );
                            echo "\n\n";

                            $this->flushOutput();
                        }

                        $writeLog('BUFFERED_SSE_STREAM_CLOSED');

                    },
                    200,
                    [
                        'Content-Type' => 'text/event-stream; charset=utf-8',
                        'Cache-Control' => 'no-cache',
                        'X-Accel-Buffering' => 'no',
                    ]
                );
            }
            $isChunked = isset($upstreamHeaders['transfer-encoding'])
                && stripos($upstreamHeaders['transfer-encoding'], 'chunked') !== false;
            $writeLog(
                'PYTHON_BODY_MODE: ' .
                ($isChunked ? 'chunked' : (isset($upstreamHeaders['content-length']) ? 'content-length' : 'connection-close'))
            );
            $responseHeaders = [
                'Content-Type' => $upstreamHeaders['content-type'] ?? 'application/json',
                'Cache-Control' => $upstreamHeaders['cache-control'] ?? 'no-cache',
                'X-Accel-Buffering' => 'no',
            ];

            if (!$isChunked && isset($upstreamHeaders['content-length'])) {
                $responseHeaders['Content-Length'] = $upstreamHeaders['content-length'];
            }

            if (isset($upstreamHeaders['retry-after'])) {
                $responseHeaders['Retry-After'] = $upstreamHeaders['retry-after'];
            }
            $writeLog('LARAVEL_STREAM_RESPONSE_CREATED');

            return response()->stream(
                function () use ($socket, $isChunked, $upstreamHeaders, $writeLog) {
                    @set_time_limit(0);
                    $writeLog('RESPONSE_STREAM_STARTED');

                    try {
                        if ($isChunked) {
                            $this->streamChunkedBody($socket, $writeLog);
                        } elseif (isset($upstreamHeaders['content-length'])) {
                            $remaining = (int) $upstreamHeaders['content-length'];

                            while ($remaining > 0) {
                                $chunk = fread($socket, min(8192, $remaining));

                                if ($chunk === false || $chunk === '') {
                                    break;
                                }

                                echo $chunk;
                                $remaining -= strlen($chunk);
                                $this->flushOutput();
                            }
                        } else {
                            while (!feof($socket)) {
                                $chunk = fread($socket, 8192);

                                if ($chunk === false || $chunk === '') {
                                    break;
                                }

                                echo $chunk;
                                $this->flushOutput();
                            }
                        }

                        $writeLog('RESPONSE_BODY_READ_ENDED');

                    } catch (\Throwable $e) {
                        $writeLog('RESPONSE_STREAM_ERROR: ' . $e->getMessage());
                        throw $e;
                    } finally {
                        $writeLog('RESPONSE_STREAM_CLOSED');
                    
                        if (is_resource($socket)) {
                            fclose($socket);
                        }
                    }
                },
                $statusCode,
                $responseHeaders
            );

        } catch (\Throwable $e) {

            $writeLog('GATEWAY_ERROR: ' . $stage . ' | ' . $e->getMessage());

            if (is_resource($socket)) {
                fclose($socket);
            }

            report($e);

            return response()->json([
                'error' => 'Gateway connection failed',
                'message' => 'Could not communicate with the Python gateway.',
            ], 502);
        }
    }
        private function fetchBufferedResponse(
        string $internalToken,
        callable $writeLog,
        callable $sendHeartbeat
    ): array {
        $url = 'http://127.0.0.1:8088/api/internal/responses/consume';

        $lastHeartbeat = microtime(true);

        while (true) {
            $response = Http::withHeaders([
                'X-Gateway-Internal-Token' => $internalToken,
                'Accept' => 'application/json',
            ])
                ->connectTimeout(5)
                ->timeout(10)
                ->post($url);

            $status = $response->status();

            if ($status === 202) {
                if (microtime(true) - $lastHeartbeat >= 15) {
                    $sendHeartbeat();
                    $lastHeartbeat = microtime(true);
                }

                usleep(500000);
                continue;
            }

            if ($status === 200) {
                $payload = $response->json();

                if (!is_array($payload)) {
                    throw new \RuntimeException(
                        'Invalid buffered response JSON.'
                    );
                }

                $writeLog('BUFFERED_RESPONSE_RECEIVED');

                return $payload;
            }

            $writeLog('BUFFERED_CONSUME_ERROR', [
                'status' => $status,
                'body' => $response->body(),
            ]);

            throw new \RuntimeException(
                'Buffered response consume failed with HTTP ' . $status
            );
        }
    }

    private function responsesToSseEvents(array $response): array
    {
        $responseId = $response['id'] ?? 'resp_gateway';
        $output = $response['output'] ?? [];

        $sequenceNumber = 0;

        $makeEvent = function (
            string $type,
            array $data
        ) use (&$sequenceNumber): string {
            $sequenceNumber++;

            $data['type'] = $type;
            $data['sequence_number'] = $sequenceNumber;

            return 'event: ' . $type . "\n"
                . 'data: ' . json_encode(
                    $data,
                    JSON_UNESCAPED_UNICODE |
                    JSON_UNESCAPED_SLASHES |
                    JSON_THROW_ON_ERROR
                )
                . "\n\n";
        };

        $events = [];

        $events[] = $makeEvent('response.created', [
            'response' => array_merge($response, [
                'status' => 'in_progress',
                'output' => [],
            ]),
        ]);

        $events[] = $makeEvent('response.in_progress', [
            'response' => array_merge($response, [
                'status' => 'in_progress',
                'output' => [],
            ]),
        ]);

        foreach ($output as $outputIndex => $item) {
            if (!is_array($item)) {
                continue;
            }

            $itemId = $item['id'] ?? "item_{$outputIndex}";

            $events[] = $makeEvent('response.output_item.added', [
                'response_id' => $responseId,
                'output_index' => $outputIndex,
                'item' => array_merge($item, [
                    'status' => 'in_progress',
                ]),
            ]);

            if (($item['type'] ?? null) === 'message') {
                foreach (($item['content'] ?? []) as $contentIndex => $part) {
                    if (!is_array($part)) {
                        continue;
                    }

                    $partType = $part['type'] ?? null;

                    if (!in_array($partType, ['output_text', 'refusal'], true)) {
                        continue;
                    }

                    if ($partType === 'refusal') {
                        $refusal = $part['refusal'] ?? '';

                        $events[] = $makeEvent('response.content_part.added', [
                            'response_id' => $responseId,
                            'item_id' => $itemId,
                            'output_index' => $outputIndex,
                            'content_index' => $contentIndex,
                            'part' => [
                                'type' => 'refusal',
                                'refusal' => '',
                            ],
                        ]);

                        if ($refusal !== '') {
                            $events[] = $makeEvent('response.refusal.delta', [
                                'response_id' => $responseId,
                                'item_id' => $itemId,
                                'output_index' => $outputIndex,
                                'content_index' => $contentIndex,
                                'delta' => $refusal,
                            ]);
                        }

                        $events[] = $makeEvent('response.refusal.done', [
                            'response_id' => $responseId,
                            'item_id' => $itemId,
                            'output_index' => $outputIndex,
                            'content_index' => $contentIndex,
                            'refusal' => $refusal,
                        ]);

                        $events[] = $makeEvent('response.content_part.done', [
                            'response_id' => $responseId,
                            'item_id' => $itemId,
                            'output_index' => $outputIndex,
                            'content_index' => $contentIndex,
                            'part' => $part,
                        ]);

                        continue;
                    }
                    $text = $part['text'] ?? '';

                    $events[] = $makeEvent('response.content_part.added', [
                        'response_id' => $responseId,
                        'item_id' => $itemId,
                        'output_index' => $outputIndex,
                        'content_index' => $contentIndex,
                        'part' => array_merge($part, [
                            'text' => '',
                        ]),
                    ]);

                    if ($text !== '') {
                        $events[] = $makeEvent('response.output_text.delta', [
                            'response_id' => $responseId,
                            'item_id' => $itemId,
                            'output_index' => $outputIndex,
                            'content_index' => $contentIndex,
                            'delta' => $text,
                        ]);
                    }

                    $events[] = $makeEvent('response.output_text.done', [
                        'response_id' => $responseId,
                        'item_id' => $itemId,
                        'output_index' => $outputIndex,
                        'content_index' => $contentIndex,
                        'text' => $text,
                    ]);

                    $events[] = $makeEvent('response.content_part.done', [
                        'response_id' => $responseId,
                        'item_id' => $itemId,
                        'output_index' => $outputIndex,
                        'content_index' => $contentIndex,
                        'part' => $part,
                    ]);
                }
            } elseif (($item['type'] ?? null) === 'function_call') {
                $arguments = $item['arguments'] ?? '';

                $events[] = $makeEvent('response.function_call_arguments.delta', [
                    'response_id' => $responseId,
                    'item_id' => $itemId,
                    'output_index' => $outputIndex,
                    'delta' => $arguments,
                ]);

                $events[] = $makeEvent('response.function_call_arguments.done', [
                    'response_id' => $responseId,
                    'item_id' => $itemId,
                    'output_index' => $outputIndex,
                    'arguments' => $arguments,
                ]);
            }

            $events[] = $makeEvent('response.output_item.done', [
                'response_id' => $responseId,
                'output_index' => $outputIndex,
                'item' => $item,
            ]);
        }
        
        $responseStatus = $response['status'] ?? null;
        
        $terminalEvent = match ($responseStatus) {
            'completed' => 'response.completed',
            'incomplete' => 'response.incomplete',
            'failed' => 'response.failed',
            default => throw new \RuntimeException(
                'Unsupported terminal response status: ' .
                (string) $responseStatus
            ),
        }; 


        $events[] = $makeEvent($terminalEvent, [
            'response' => $response,
        ]);

        return $events;
    }

    private function writeAll($socket, string $data): void
    {
        $length = strlen($data);
        $written = 0;

        while ($written < $length) {
            $result = fwrite($socket, substr($data, $written));

            if ($result === false || $result === 0) {
                throw new \RuntimeException('Failed to write request to Python gateway.');
            }

            $written += $result;
        }
    }

    private function readExact($socket, int $length): string
    {
        $result = '';

        while (strlen($result) < $length) {
            $chunk = fread($socket, $length - strlen($result));

            if ($chunk === false || $chunk === '') {
                throw new \RuntimeException('Unexpected end of chunked response.');
            }

            $result .= $chunk;
        }

        return $result;
    }

    private function streamChunkedBody(
        $socket,
        callable $writeLog
    ): void {
    
        $chunkCount = 0;
        $totalBytes = 0;
        $heartbeatCount = 0;
    
        while (true) {
    
            $line = fgets($socket, 8192);
    
            if ($line === false) {
    
                $meta = stream_get_meta_data($socket);
    
                throw new \RuntimeException(
                    'Unexpected end of chunked response: ' .
                    json_encode($meta)
                );
            }
    
            $sizeText = trim(
                explode(';', trim($line), 2)[0]
            );
    
            if ($sizeText === '' || !ctype_xdigit($sizeText)) {
                throw new \RuntimeException(
                    'Invalid HTTP chunk size: ' . trim($line)
                );
            }
    
            $chunkSize = hexdec($sizeText);
    
            if ($chunkSize === 0) {
    
                $trailerComplete = false;
    
                while (($trailer = fgets($socket, 8192)) !== false) {
    
                    if ($trailer === "\r\n" || $trailer === "\n") {
                        $trailerComplete = true;
                        break;
                    }
                }
    
                if (!$trailerComplete) {
                    throw new \RuntimeException(
                        'Incomplete HTTP chunk trailer.'
                    );
                }
    
                break;
            }
    
            $chunk = $this->readExact($socket, $chunkSize);
    
            $chunkCount++;
            $totalBytes += strlen($chunk);
    
            if (str_contains($chunk, ': heartbeat')) {
    
                $heartbeatCount++;
    
                $writeLog('UPSTREAM_HEARTBEAT_RECEIVED', [
                    'heartbeat_count' => $heartbeatCount,
                    'chunk' => $chunkCount,
                ]);
            }
    
            echo $chunk;
            $this->flushOutput();
    
            $crlf = $this->readExact($socket, 2);
    
            if ($crlf !== "\r\n") {
                throw new \RuntimeException(
                    'Invalid HTTP chunk terminator.'
                );
            }
        }
    
        $writeLog('UPSTREAM_CHUNKED_BODY_COMPLETE', [
            'chunks' => $chunkCount,
            'bytes' => $totalBytes,
            'heartbeats' => $heartbeatCount,
        ]);
    }



    private function flushOutput(): void
    {
        if (ob_get_level() > 0) {
            @ob_flush();
        }

        flush();
    }

    public function mt5(Request $request): JsonResponse
    {
        return response()->json([
            'gateway' => 'Rezvan Gateway',
            'endpoint' => 'mt5',
            'status' => 'received',
            'input_keys' => array_keys($request->all()),
        ]);
    }
