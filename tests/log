extern "C" __declspec(dllexport)
int __stdcall SendLatestJson()
{
    for (int attempt = 0; attempt < 3; ++attempt)
    {
        std::vector<unsigned char> fileData;
        std::string json;

        if (ReadFileBytes(FILE_PATH, fileData) &&
            ConvertToUTF8(fileData, json))
        {
            std::string hash = CalculateSHA256(json);

            if (hash.empty())
                return -10;

            // اگر JSON قبلاً ارسال شده، ارسال نکن
            if (hash == lastSentHash)
                return 204;

            int status = SendHTTP(json);

            // فقط ارسال موفق را ذخیره کن
            if (status >= 200 && status < 300)
            {
                lastSentHash = hash;
                return status;
            }

            // خطای HTTP
            return status;
        }

        // فرصت برای کامل شدن فایل
        if (attempt < 2)
            std::this_thread::sleep_for(
                std::chrono::seconds(5)
            );
    }

    return -20;
}



