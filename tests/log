<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Http\JsonResponse;
use Illuminate\Support\Facades\Http;

class GatewayController extends Controller
{
    private const PYTHON_URL = 'tcp://127.0.0.1:8088';
    private const CONSUME_URL = 'http://127.0.0.1:8088/api/internal/responses/consume';

    private const POLL_INTERVAL_SECONDS = 2;
    private const INITIAL_WAIT_SECONDS = 2;

    public function codex(Request $request): JsonResponse
    {
        @set_time_limit(0);

        $requestId = bin2hex(random_bytes(8));
        $startedAt = microtime(true);
        $token = (string) env('GATEWAY_RESPONSE_BUFFER_TOKEN', '');

        $previousResponse = null;
        $socket = null;

        $logPath = storage_path('logs/gateway-poll-probe.log');

        $log = function (
            string $event,
            array $context = []
        ) use ($logPath, $requestId, $startedAt): void {

            $entry = [
                'time' => date('Y-m-d H:i:s'),
                'request_id' => $requestId,
                'elapsed_ms' => (int) round(
                    (microtime(true) - $startedAt) * 1000
                ),
                'event' => $event,
                'context' => $context,
            ];

            file_put_contents(
                $logPath,
                json_encode(
                    $entry,
                    JSON_UNESCAPED_UNICODE |
                    JSON_UNESCAPED_SLASHES
                ) . PHP_EOL,
                FILE_APPEND | LOCK_EX
            );
        };

        try {
            if ($token === '') {
                throw new \RuntimeException(
                    'Gateway response buffer token is missing.'
                );
            }

            $body = $request->getContent();

            $payload = json_decode($body);

            if (!is_object($payload)) {
                return response()->json([
                    'error' => 'Invalid JSON request.',
                ], 400);
            }

            $log('PROBE_STARTED', [
                'body_bytes' => strlen($body),
            ]);

            /*
             * 1. Send current request.
             */

            $initial = $this->sendPythonRequest(
                $body,
                $requestId,
                $log
            );

            $pythonStatus = $initial['status'];
            $pythonJson = $initial['json'];

            /*
             * 2. Handle a previous active buffered response.
             */

            if (
                $pythonStatus === 409 &&
                is_array($pythonJson) &&
                ($pythonJson['status'] ?? null) === 'consumer_busy'
            ) {
                $log('PREVIOUS_BUFFERED_REQUEST_DETECTED');

                $previousResponse = $this->pollConsume(
                    $token,
                    $requestId,
                    'previous',
                    $log
                );

                $log('PREVIOUS_BUFFERED_RESPONSE_RECEIVED', [
                    'response_id' => $previousResponse['id'] ?? null,
                    'response_status' => $previousResponse['status'] ?? null,
                ]);

                /*
                 * 3. Retry the current request exactly once.
                 */

                $log('CURRENT_REQUEST_RETRY_STARTED');

                $initial = $this->sendPythonRequest(
                    $body,
                    $requestId,
                    $log
                );

                $pythonStatus = $initial['status'];
                $pythonJson = $initial['json'];

                $log('CURRENT_REQUEST_RETRY_RESULT', [
                    'status' => $pythonStatus,
                    'body' => $pythonJson,
                ]);
            }

            /*
             * 4. Current request must now be accepted.
             */

            if ($pythonStatus !== 202) {
                $log('CURRENT_REQUEST_NOT_ACCEPTED', [
                    'status' => $pythonStatus,
                    'body' => $pythonJson,
                ]);

                return response()->json([
                    'probe_status' => 'python_rejected',
                    'request_id' => $requestId,
                    'python_status' => $pythonStatus,
                    'python_response' => $pythonJson,
                    'previous_buffered_response' => $previousResponse,
                ], $pythonStatus);
            }

            $log('CURRENT_BUFFERED_REQUEST_ACCEPTED');

            /*
             * 5. Poll for the current request's final response.
             */

            $finalResponse = $this->pollConsume(
                $token,
                $requestId,
                'current',
                $log
            );

            $log('CURRENT_FINAL_RESPONSE_RECEIVED', [
                'response_id' => $finalResponse['id'] ?? null,
                'response_status' => $finalResponse['status'] ?? null,
            ]);

            return response()->json([
                'probe_status' => 'completed',
                'request_id' => $requestId,
                'python_initial_status' => 202,
                'previous_buffered_response' => $previousResponse,
                'final_response' => $finalResponse,
            ], 200);

        } catch (\Throwable $e) {

            $log('PROBE_ERROR', [
                'message' => $e->getMessage(),
            ]);

            if (is_resource($socket)) {
                fclose($socket);
            }

            return response()->json([
                'probe_status' => 'error',
                'request_id' => $requestId,
                'message' => $e->getMessage(),
                'previous_buffered_response' => $previousResponse,
            ], 502);
        }
    }

    /*
     * Send one HTTP request to Python over raw TCP.
     */

    private function sendPythonRequest(
        string $body,
        string $requestId,
        callable $log
    ): array {

        $socket = null;

        try {
            $errno = 0;
            $errstr = '';

            $socket = @stream_socket_client(
                self::PYTHON_URL,
                $errno,
                $errstr,
                15
            );

            if (!is_resource($socket)) {
                throw new \RuntimeException(
                    "Python connection failed: {$errstr} ({$errno})"
                );
            }

            stream_set_timeout($socket, 30);

            $log('PYTHON_CONNECTED');

            $headers =
                "POST /v1/responses HTTP/1.1\r\n" .
                "Host: 127.0.0.1:8088\r\n" .
                "X-Gateway-Request-ID: {$requestId}\r\n" .
                "Content-Type: application/json\r\n" .
                "Accept: application/json\r\n" .
                "Accept-Encoding: identity\r\n" .
                "Content-Length: " . strlen($body) . "\r\n" .
                "Connection: close\r\n" .
                "\r\n";

            $this->writeAll(
                $socket,
                $headers . $body
            );

            $log('PYTHON_REQUEST_SENT', [
                'bytes' => strlen($headers . $body),
            ]);

            /*
             * Preserve the original two-second wait.
             */

            $log('WAITING_TWO_SECONDS');

            sleep(self::INITIAL_WAIT_SECONDS);

            $statusLine = fgets($socket, 8192);

            if ($statusLine === false) {
                throw new \RuntimeException(
                    'Could not read Python HTTP status line.'
                );
            }

            if (!preg_match(
                '/^HTTP\/\d(?:\.\d)?\s+(\d{3})/',
                $statusLine,
                $matches
            )) {
                throw new \RuntimeException(
                    'Invalid Python HTTP status line: ' .
                    trim($statusLine)
                );
            }

            $status = (int) $matches[1];

            $log('PYTHON_STATUS_RECEIVED', [
                'status' => $status,
                'status_line' => trim($statusLine),
            ]);

            $pythonHeaders = [];

            while (($line = fgets($socket, 8192)) !== false) {

                if ($line === "\r\n" || $line === "\n") {
                    break;
                }

                $separator = strpos($line, ':');

                if ($separator === false) {
                    continue;
                }

                $name = strtolower(
                    trim(substr($line, 0, $separator))
                );

                $value = trim(
                    substr($line, $separator + 1)
                );

                $pythonHeaders[$name] = $value;
            }

            if (isset($pythonHeaders['content-length'])) {

                $pythonBody = $this->readExact(
                    $socket,
                    (int) $pythonHeaders['content-length']
                );

            } else {

                $pythonBody = stream_get_contents($socket);

                if ($pythonBody === false) {
                    throw new \RuntimeException(
                        'Could not read Python response body.'
                    );
                }
            }

            $pythonJson = json_decode(
                $pythonBody,
                true
            );

            $log('PYTHON_INITIAL_RESPONSE_READ', [
                'status' => $status,
                'body_bytes' => strlen($pythonBody),
                'body' => $pythonJson,
            ]);

            return [
                'status' => $status,
                'json' => $pythonJson ?? $pythonBody,
            ];

        } finally {

            if (is_resource($socket)) {
                fclose($socket);
            }
        }
    }

    /*
     * Poll Python consume endpoint until a response is ready.
     *
     * $kind distinguishes the previous request from the current request.
     */

    private function pollConsume(
        string $token,
        string $requestId,
        string $kind,
        callable $log
    ): array {

        $pollCount = 0;

        $log('POLLING_STARTED', [
            'kind' => $kind,
            'interval_seconds' => self::POLL_INTERVAL_SECONDS,
        ]);

        while (true) {

            $pollCount++;

            $pollStartedAt = microtime(true);

            $pollResponse = Http::withHeaders([
                'X-Gateway-Internal-Token' => $token,
                'Accept' => 'application/json',
            ])
                ->connectTimeout(5)
                ->timeout(30)
                ->post(self::CONSUME_URL);

            $pollStatus = $pollResponse->status();

            $pollElapsedMs = (int) round(
                (microtime(true) - $pollStartedAt) * 1000
            );

            if ($pollStatus === 202) {

                $log('POLL_NOT_READY', [
                    'kind' => $kind,
                    'poll_number' => $pollCount,
                    'http_status' => 202,
                    'request_elapsed_ms' => $pollElapsedMs,
                ]);

                sleep(self::POLL_INTERVAL_SECONDS);

                continue;
            }

            if ($pollStatus === 200) {

                $payload = $pollResponse->json();

                if (!is_array($payload)) {
                    throw new \RuntimeException(
                        "Invalid {$kind} buffered response JSON."
                    );
                }

                $log('POLL_RESPONSE_RECEIVED', [
                    'kind' => $kind,
                    'poll_number' => $pollCount,
                    'response_id' => $payload['id'] ?? null,
                    'response_status' => $payload['status'] ?? null,
                ]);

                return $payload;
            }

            $log('POLL_ERROR', [
                'kind' => $kind,
                'poll_number' => $pollCount,
                'http_status' => $pollStatus,
                'body' => $pollResponse->body(),
            ]);

            throw new \RuntimeException(
                "{$kind} buffered response consume failed with HTTP {$pollStatus}: " .
                $pollResponse->body()
            );
        }
    }

    private function writeAll($socket, string $data): void
    {
        $length = strlen($data);
        $written = 0;

        while ($written < $length) {

            $result = fwrite(
                $socket,
                substr($data, $written)
            );

            if ($result === false || $result === 0) {
                throw new \RuntimeException(
                    'Failed to write request to Python.'
                );
            }

            $written += $result;
        }
    }

    private function readExact($socket, int $length): string
    {
        $result = '';

        while (strlen($result) < $length) {

            $chunk = fread(
                $socket,
                $length - strlen($result)
            );

            if ($chunk === false || $chunk === '') {
                throw new \RuntimeException(
                    'Unexpected end of Python HTTP response body.'
                );
            }

            $result .= $chunk;
        }

        return $result;
    }
}








