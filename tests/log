<?php

namespace App\Http\Controllers;

use Illuminate\Http\Request;
use Illuminate\Http\JsonResponse;
use Symfony\Component\HttpFoundation\StreamedResponse;

class GatewayController extends Controller
{
    private const PYTHON_URL = 'tcp://127.0.0.1:8088';

    public function codex(Request $request): JsonResponse|StreamedResponse
    {
        @set_time_limit(0);

        $requestId = bin2hex(random_bytes(8));
        $startedAt = microtime(true);

        $token = (string) env(
            'GATEWAY_RESPONSE_BUFFER_TOKEN',
            ''
        );

        $logPath = storage_path('logs/gateway-codex.log');

        $log = function (
            string $event,
            array $context = []
        ) use ($logPath, $requestId, $startedAt): void {

            $entry = [
                'time' => date('Y-m-d H:i:s'),
                'request_id' => $requestId,
                'elapsed_ms' => (int) round(
                    (microtime(true) - $startedAt) * 1000
                ),
                'event' => $event,
                'context' => $context,
            ];

            file_put_contents(
                $logPath,
                json_encode(
                    $entry,
                    JSON_UNESCAPED_UNICODE |
                    JSON_UNESCAPED_SLASHES
                ) . PHP_EOL,
                FILE_APPEND | LOCK_EX
            );
        };

        if ($token === '') {
            return response()->json([
                'error' => [
                    'message' => 'Gateway response buffer token is missing.',
                ],
            ], 500);
        }

        $body = $request->getContent();

        try {
            $payload = json_decode(
                $body,
                false,
                512,
                JSON_THROW_ON_ERROR
            );

            if (!is_object($payload)) {
                throw new \RuntimeException(
                    'Request body must be a JSON object.'
                );
            }

        } catch (\Throwable $e) {
            return response()->json([
                'error' => [
                    'message' => 'Invalid JSON request.',
                ],
            ], 400);
        }

        $streamRequested = ($payload->stream ?? false) === true;

        $log('CODEX_REQUEST_STARTED', [
            'body_bytes' => strlen($body),
            'stream' => $streamRequested,
        ]);

        /*
         * Streaming response for Codex.
         */

        if ($streamRequested) {

            return response()->stream(

                function () use (
                    $body,
                    $token,
                    $requestId,
                    $log
                ): void {

                    @set_time_limit(0);
                    @ini_set('zlib.output_compression', '0');

                    while (ob_get_level() > 0) {
                        @ob_end_flush();
                    }

                    $heartbeat = function () use ($log): void {
                        echo ": heartbeat\n\n";

                        $this->flushOutput();

                        $log('CLIENT_HEARTBEAT_SENT');
                    };

                    try {

                        $finalResponse = $this->processBufferedRequest(
                            $body,
                            $token,
                            $requestId,
                            $log,
                            $heartbeat
                        );

                        $log('SSE_DELIVERY_STARTED', [
                            'response_id' => $finalResponse['id'] ?? null,
                            'response_status' => $finalResponse['status'] ?? null,
                        ]);

                        $events = $this->responsesToSseEvents(
                            $finalResponse
                        );

                        foreach ($events as $event) {
                            echo $event;
                            $this->flushOutput();
                        }

                        $log('SSE_DELIVERY_COMPLETED', [
                            'event_count' => count($events),
                        ]);

                    } catch (\Throwable $e) {

                        $log('SSE_DELIVERY_ERROR', [
                            'message' => $e->getMessage(),
                        ]);

                        echo $this->sseEvent('error', [
                            'error' => [
                                'message' => $e->getMessage(),
                                'type' => 'server_error',
                            ],
                        ]);

                        $this->flushOutput();
                    }

                    $log('SSE_STREAM_CLOSED');
                },

                200,

                [
                    'Content-Type' => 'text/event-stream; charset=utf-8',
                    'Cache-Control' => 'no-cache, no-transform',
                    'Connection' => 'keep-alive',
                    'X-Accel-Buffering' => 'no',
                ]
            );
        }

        /*
         * Non-streaming response.
         */

        try {

            $finalResponse = $this->processBufferedRequest(
                $body,
                $token,
                $requestId,
                $log,
                static function (): void {
                    // No heartbeat for JSON responses.
                }
            );

            $log('JSON_DELIVERY_COMPLETED', [
                'response_id' => $finalResponse['id'] ?? null,
            ]);

            return response()->json(
                $finalResponse,
                200,
                [
                    'Cache-Control' => 'no-store',
                ]
            );

        } catch (\Throwable $e) {

            $status = (int) $e->getCode();

            if ($status < 400 || $status > 599) {
                $status = 502;
            }

            $log('JSON_DELIVERY_ERROR', [
                'status' => $status,
                'message' => $e->getMessage(),
            ]);

            return response()->json([
                'error' => [
                    'message' => $e->getMessage(),
                    'type' => 'server_error',
                ],
            ], $status);
        }
    }


    /*
     * Send request, handle 409, retry once,
     * and consume the final buffered response.
     */

    private function processBufferedRequest(
        string $body,
        string $token,
        string $requestId,
        callable $log,
        callable $heartbeat
    ): array {

        $initial = $this->sendPythonRequest(
            $body,
            $requestId,
            $log,
            $heartbeat
        );

        $pythonStatus = $initial['status'];
        $pythonJson = $initial['json'];

        /*
         * Handle previous active response.
         */

        if (
            $pythonStatus === 409 &&
            is_array($pythonJson) &&
            ($pythonJson['status'] ?? null) === 'consumer_busy'
        ) {

            $log('PREVIOUS_BUFFERED_REQUEST_DETECTED');

            $previousResponse = $this->pollConsume(
                $token,
                $requestId,
                'previous',
                $log,
                $heartbeat
            );

            $log('PREVIOUS_BUFFERED_RESPONSE_RECEIVED', [
                'response_id' => $previousResponse['id'] ?? null,
                'response_status' => $previousResponse['status'] ?? null,
            ]);

            /*
             * Retry current request once.
             */

            $log('CURRENT_REQUEST_RETRY_STARTED');

            $initial = $this->sendPythonRequest(
                $body,
                $requestId,
                $log,
                $heartbeat
            );

            $pythonStatus = $initial['status'];
            $pythonJson = $initial['json'];

            $log('CURRENT_REQUEST_RETRY_RESULT', [
                'status' => $pythonStatus,
                'body' => $pythonJson,
            ]);
        }

        /*
         * Current request must be accepted.
         */

        if ($pythonStatus !== 202) {

            $log('CURRENT_REQUEST_NOT_ACCEPTED', [
                'status' => $pythonStatus,
                'body' => $pythonJson,
            ]);

            $errorStatus = (
                $pythonStatus >= 400 &&
                $pythonStatus <= 599
            ) ? $pythonStatus : 502;

            throw new \RuntimeException(
                'Python rejected the request. HTTP ' .
                $pythonStatus . ': ' .
                json_encode(
                    $pythonJson,
                    JSON_UNESCAPED_UNICODE |
                    JSON_UNESCAPED_SLASHES
                ),
                $errorStatus
            );
        }

        $log('CURRENT_BUFFERED_REQUEST_ACCEPTED');

        /*
         * Poll for current response.
         */

        $finalResponse = $this->pollConsume(
            $token,
            $requestId,
            'current',
            $log,
            $heartbeat
        );

        $log('CURRENT_FINAL_RESPONSE_RECEIVED', [
            'response_id' => $finalResponse['id'] ?? null,
            'response_status' => $finalResponse['status'] ?? null,
        ]);

        return $finalResponse;
    }


    /*
     * Send one HTTP request to Python over raw TCP.
     */

    private function sendPythonRequest(
        string $body,
        string $requestId,
        callable $log,
        callable $heartbeat
    ): array {

        $socket = null;

        try {
            $errno = 0;
            $errstr = '';

            $socket = @stream_socket_client(
                self::PYTHON_URL,
                $errno,
                $errstr,
                15
            );

            if (!is_resource($socket)) {
                throw new \RuntimeException(
                    "Python connection failed: {$errstr} ({$errno})"
                );
            }

            stream_set_timeout($socket, 60);

            $log('PYTHON_CONNECTED');

            $headers =
                "POST /v1/responses HTTP/1.1\r\n" .
                "Host: 127.0.0.1:8088\r\n" .
                "X-Gateway-Request-ID: {$requestId}\r\n" .
                "Content-Type: application/json\r\n" .
                "Accept: application/json\r\n" .
                "Accept-Encoding: identity\r\n" .
                "Content-Length: " . strlen($body) . "\r\n" .
                "Connection: close\r\n" .
                "\r\n";

            $this->writeAll(
                $socket,
                $headers . $body
            );

            $log('PYTHON_REQUEST_SENT', [
                'bytes' => strlen($headers . $body),
            ]);

            /*
             * Initial wait from Laravel .env.
             */

            $initialWait = (int) env(
                'GATEWAY_INITIAL_WAIT_SECONDS',
                2
            );

            $log('INITIAL_WAIT', [
                'seconds' => $initialWait,
            ]);

            $heartbeat();

            sleep($initialWait);

            $statusLine = fgets($socket, 8192);

            if ($statusLine === false) {
                throw new \RuntimeException(
                    'Could not read Python HTTP status line.'
                );
            }

            if (!preg_match(
                '/^HTTP\/\d(?:\.\d)?\s+(\d{3})/',
                $statusLine,
                $matches
            )) {
                throw new \RuntimeException(
                    'Invalid Python HTTP status line: ' .
                    trim($statusLine)
                );
            }

            $status = (int) $matches[1];

            $log('PYTHON_STATUS_RECEIVED', [
                'status' => $status,
                'status_line' => trim($statusLine),
            ]);

            $pythonHeaders = [];

            while (($line = fgets($socket, 8192)) !== false) {

                if ($line === "\r\n" || $line === "\n") {
                    break;
                }

                $separator = strpos($line, ':');

                if ($separator === false) {
                    continue;
                }

                $name = strtolower(
                    trim(substr($line, 0, $separator))
                );

                $value = trim(
                    substr($line, $separator + 1)
                );

                $pythonHeaders[$name] = $value;
            }

            if (isset($pythonHeaders['content-length'])) {

                $pythonBody = $this->readExact(
                    $socket,
                    (int) $pythonHeaders['content-length']
                );

            } else {

                $pythonBody = stream_get_contents($socket);

                if ($pythonBody === false) {
                    throw new \RuntimeException(
                        'Could not read Python response body.'
                    );
                }
            }

            $pythonJson = json_decode(
                $pythonBody,
                true
            );

            $log('PYTHON_INITIAL_RESPONSE_READ', [
                'status' => $status,
                'body_bytes' => strlen($pythonBody),
                'body' => $pythonJson,
            ]);

            return [
                'status' => $status,
                'json' => $pythonJson ?? $pythonBody,
            ];

        } finally {

            if (is_resource($socket)) {
                fclose($socket);
            }
        }
    }


    /*
     * Poll Python consume endpoint until response is ready.
     */

    private function pollConsume(
        string $token,
        string $requestId,
        string $kind,
        callable $log,
        callable $heartbeat
    ): array {

        $pollCount = 0;

        $pollInterval = (int) env(
            'GATEWAY_POLL_INTERVAL_SECONDS',
            2
        );

        $log('POLLING_STARTED', [
            'kind' => $kind,
            'interval_seconds' => $pollInterval,
        ]);

        while (true) {

            $pollCount++;
            $pollStartedAt = microtime(true);

            $result = $this->sendConsumeRequest($token);

            $pollStatus = $result['status'];
            $payload = $result['json'];

            $pollElapsedMs = (int) round(
                (microtime(true) - $pollStartedAt) * 1000
            );

            if ($pollStatus === 202) {

                $log('POLL_NOT_READY', [
                    'kind' => $kind,
                    'poll_number' => $pollCount,
                    'http_status' => 202,
                    'request_elapsed_ms' => $pollElapsedMs,
                ]);

                $heartbeat();

                sleep($pollInterval);

                continue;
            }

            if ($pollStatus === 200) {

                if (!is_array($payload)) {
                    throw new \RuntimeException(
                        "Invalid {$kind} buffered response JSON."
                    );
                }

                $log('POLL_RESPONSE_RECEIVED', [
                    'kind' => $kind,
                    'poll_number' => $pollCount,
                    'response_id' => $payload['id'] ?? null,
                    'response_status' => $payload['status'] ?? null,
                ]);

                return $payload;
            }

            $log('POLL_ERROR', [
                'kind' => $kind,
                'poll_number' => $pollCount,
                'http_status' => $pollStatus,
                'body' => $payload,
            ]);

            throw new \RuntimeException(
                "{$kind} consume failed with HTTP {$pollStatus}: " .
                json_encode(
                    $payload,
                    JSON_UNESCAPED_UNICODE |
                    JSON_UNESCAPED_SLASHES
                )
            );
        }
    }


    /*
     * Send consume request to Python over raw TCP.
     */

    private function sendConsumeRequest(string $token): array
    {
        $socket = null;

        try {
            $errno = 0;
            $errstr = '';

            $socket = @stream_socket_client(
                self::PYTHON_URL,
                $errno,
                $errstr,
                15
            );

            if (!is_resource($socket)) {
                throw new \RuntimeException(
                    "Python consume connection failed: {$errstr} ({$errno})"
                );
            }

            stream_set_timeout($socket, 60);

            $body = '{}';

            $headers =
                "POST /api/internal/responses/consume HTTP/1.1\r\n" .
                "Host: 127.0.0.1:8088\r\n" .
                "X-Gateway-Internal-Token: {$token}\r\n" .
                "Content-Type: application/json\r\n" .
                "Accept: application/json\r\n" .
                "Accept-Encoding: identity\r\n" .
                "Content-Length: " . strlen($body) . "\r\n" .
                "Connection: close\r\n" .
                "\r\n";

            $this->writeAll(
                $socket,
                $headers . $body
            );

            $statusLine = fgets($socket, 8192);

            if ($statusLine === false) {
                throw new \RuntimeException(
                    'Could not read consume HTTP status line.'
                );
            }

            if (!preg_match(
                '/^HTTP\/\d(?:\.\d)?\s+(\d{3})/',
                $statusLine,
                $matches
            )) {
                throw new \RuntimeException(
                    'Invalid consume HTTP status line: ' .
                    trim($statusLine)
                );
            }

            $status = (int) $matches[1];
            $responseHeaders = [];

            while (($line = fgets($socket, 8192)) !== false) {

                if ($line === "\r\n" || $line === "\n") {
                    break;
                }

                $separator = strpos($line, ':');

                if ($separator === false) {
                    continue;
                }

                $name = strtolower(
                    trim(substr($line, 0, $separator))
                );

                $value = trim(
                    substr($line, $separator + 1)
                );

                $responseHeaders[$name] = $value;
            }

            if (isset($responseHeaders['content-length'])) {

                $responseBody = $this->readExact(
                    $socket,
                    (int) $responseHeaders['content-length']
                );

            } else {

                $responseBody = stream_get_contents($socket);

                if ($responseBody === false) {
                    throw new \RuntimeException(
                        'Could not read consume response body.'
                    );
                }
            }

            $responseJson = json_decode(
                $responseBody,
                true
            );

            return [
                'status' => $status,
                'json' => $responseJson ?? $responseBody,
            ];

        } finally {

            if (is_resource($socket)) {
                fclose($socket);
            }
        }
    }


    /*
     * Convert complete Responses API object to SSE events.
     */

    private function responsesToSseEvents(array $response): array
    {
        $responseId = $response['id'] ?? 'resp_gateway';
        $output = $response['output'] ?? [];

        if (!is_array($output)) {
            $output = [];
        }

        $events = [];

        $inProgressResponse = $response;
        $inProgressResponse['status'] = 'in_progress';
        $inProgressResponse['output'] = [];

        $events[] = $this->sseEvent('response.created', [
            'response' => $inProgressResponse,
        ]);

        $events[] = $this->sseEvent('response.in_progress', [
            'response' => $inProgressResponse,
        ]);

        foreach ($output as $outputIndex => $item) {

            if (!is_array($item)) {
                continue;
            }

            $itemId = $item['id'] ?? "item_{$outputIndex}";

            $addedItem = $item;
            $addedItem['status'] = 'in_progress';

            $events[] = $this->sseEvent(
                'response.output_item.added',
                [
                    'response_id' => $responseId,
                    'output_index' => $outputIndex,
                    'item' => $addedItem,
                ]
            );

            if (($item['type'] ?? null) === 'message') {

                $content = $item['content'] ?? [];

                if (!is_array($content)) {
                    $content = [];
                }

                foreach ($content as $contentIndex => $part) {

                    if (!is_array($part)) {
                        continue;
                    }

                    $partType = $part['type'] ?? '';

                    if ($partType === 'refusal') {

                        $refusal = $part['refusal'] ?? '';

                        $events[] = $this->sseEvent(
                            'response.content_part.added',
                            [
                                'response_id' => $responseId,
                                'item_id' => $itemId,
                                'output_index' => $outputIndex,
                                'content_index' => $contentIndex,
                                'part' => [
                                    'type' => 'refusal',
                                    'refusal' => '',
                                ],
                            ]
                        );

                        if ($refusal !== '') {
                            $events[] = $this->sseEvent(
                                'response.refusal.delta',
                                [
                                    'response_id' => $responseId,
                                    'item_id' => $itemId,
                                    'output_index' => $outputIndex,
                                    'content_index' => $contentIndex,
                                    'delta' => $refusal,
                                ]
                            );
                        }

                        $events[] = $this->sseEvent(
                            'response.refusal.done',
                            [
                                'response_id' => $responseId,
                                'item_id' => $itemId,
                                'output_index' => $outputIndex,
                                'content_index' => $contentIndex,
                                'refusal' => $refusal,
                            ]
                        );

                        $events[] = $this->sseEvent(
                            'response.content_part.done',
                            [
                                'response_id' => $responseId,
                                'item_id' => $itemId,
                                'output_index' => $outputIndex,
                                'content_index' => $contentIndex,
                                'part' => $part,
                            ]
                        );

                        continue;
                    }

                    $text = $part['text'] ?? '';

                    $emptyPart = $part;
                    $emptyPart['text'] = '';

                    $events[] = $this->sseEvent(
                        'response.content_part.added',
                        [
                            'response_id' => $responseId,
                            'item_id' => $itemId,
                            'output_index' => $outputIndex,
                            'content_index' => $contentIndex,
                            'part' => $emptyPart,
                        ]
                    );

                    if (is_string($text) && $text !== '') {

                        $events[] = $this->sseEvent(
                            'response.output_text.delta',
                            [
                                'response_id' => $responseId,
                                'item_id' => $itemId,
                                'output_index' => $outputIndex,
                                'content_index' => $contentIndex,
                                'delta' => $text,
                            ]
                        );
                    }

                    $events[] = $this->sseEvent(
                        'response.output_text.done',
                        [
                            'response_id' => $responseId,
                            'item_id' => $itemId,
                            'output_index' => $outputIndex,
                            'content_index' => $contentIndex,
                            'text' => is_string($text) ? $text : '',
                        ]
                    );

                    $events[] = $this->sseEvent(
                        'response.content_part.done',
                        [
                            'response_id' => $responseId,
                            'item_id' => $itemId,
                            'output_index' => $outputIndex,
                            'content_index' => $contentIndex,
                            'part' => $part,
                        ]
                    );
                }

            } elseif (($item['type'] ?? null) === 'function_call') {

                $arguments = $item['arguments'] ?? '';

                $events[] = $this->sseEvent(
                    'response.function_call_arguments.delta',
                    [
                        'response_id' => $responseId,
                        'item_id' => $itemId,
                        'output_index' => $outputIndex,
                        'delta' => $arguments,
                    ]
                );

                $events[] = $this->sseEvent(
                    'response.function_call_arguments.done',
                    [
                        'response_id' => $responseId,
                        'item_id' => $itemId,
                        'output_index' => $outputIndex,
                        'arguments' => $arguments,
                    ]
                );
            }

            $events[] = $this->sseEvent(
                'response.output_item.done',
                [
                    'response_id' => $responseId,
                    'output_index' => $outputIndex,
                    'item' => $item,
                ]
            );
        }

        $responseStatus = $response['status'] ?? 'completed';

        $terminalEvent = match ($responseStatus) {
            'completed' => 'response.completed',
            'incomplete' => 'response.incomplete',
            'failed' => 'response.failed',
            default => 'response.completed',
        };

        $events[] = $this->sseEvent(
            $terminalEvent,
            [
                'response' => $response,
            ]
        );

        return $events;
    }


    /*
     * Format one SSE event.
     */

    private function sseEvent(
        string $eventType,
        array $payload
    ): string {

        $payload['type'] = $eventType;

        return
            "event: {$eventType}\n" .
            'data: ' .
            json_encode(
                $payload,
                JSON_UNESCAPED_UNICODE |
                JSON_UNESCAPED_SLASHES |
                JSON_THROW_ON_ERROR
            ) .
            "\n\n";
    }


    /*
     * Write all bytes to TCP socket.
     */

    private function writeAll($socket, string $data): void
    {
        $length = strlen($data);
        $written = 0;

        while ($written < $length) {

            $result = fwrite(
                $socket,
                substr($data, $written)
            );

            if ($result === false || $result === 0) {
                throw new \RuntimeException(
                    'Failed to write request to Python.'
                );
            }

            $written += $result;
        }
    }


    /*
     * Read exact number of bytes.
     */

    private function readExact($socket, int $length): string
    {
        $result = '';

        while (strlen($result) < $length) {

            $chunk = fread(
                $socket,
                $length - strlen($result)
            );

            if ($chunk === false || $chunk === '') {
                throw new \RuntimeException(
                    'Unexpected end of Python HTTP response body.'
                );
            }

            $result .= $chunk;
        }

        return $result;
    }


    /*
     * Flush Laravel output buffers.
     */

    private function flushOutput(): void
    {
        if (ob_get_level() > 0) {
            @ob_flush();
        }

        flush();
    }
}

