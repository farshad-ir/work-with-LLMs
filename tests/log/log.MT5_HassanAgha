//+------------------------------------------------------------------+
//| Direction to text                                                 |
//+------------------------------------------------------------------+
string DirectionText(const int direction)
{
   if(direction == 1)
      return "UP";

   if(direction == -1)
      return "DOWN";

   return "UNKNOWN";
}


//+------------------------------------------------------------------+
//| Build one candle JSON object                                     |
//+------------------------------------------------------------------+
string BuildCandleObject(
   const MqlRates &bar,
   const double riverCenter,
   const double riverWidth,
   const int direction
)
{
   string timeStr = TimeToString(
      bar.time,
      TIME_DATE | TIME_MINUTES
   );

   string data = "{";

   data += "\"symbol\":\"" + _Symbol + "\",";
   data += "\"time\":\"" + timeStr + "\",";
   data += "\"open\":" + DoubleToString(bar.open, _Digits) + ",";
   data += "\"high\":" + DoubleToString(bar.high, _Digits) + ",";
   data += "\"low\":" + DoubleToString(bar.low, _Digits) + ",";
   data += "\"close\":" + DoubleToString(bar.close, _Digits) + ",";

   data += "\"tick_volume\":" + IntegerToString((long)bar.tick_volume) + ",";
   data += "\"spread_points\":" + IntegerToString(bar.spread) + ",";

   data += "\"river_center\":" + DoubleToString(riverCenter, _Digits) + ",";
   data += "\"river_width_pips\":" + DoubleToString(riverWidth, 2) + ",";

   data += "\"MABIF\":\"" + DirectionText(direction) + "\"";

   data += "}";

   return data;
}

bool GoSend(
   const string arrayName,
   const ENUM_CANDLE_SEND_MODE mode
)
{
   string records = "";

   if(arrayName == "h1Candles")
      records = h1Candles;
   else if(arrayName == "h6Candles")
      records = h6Candles;
   else
   {
      Print("[GATEWAY] Unknown candle array: ", arrayName);
      return false;
   }

   if(records == "")
   {
      Print("[GATEWAY] No candle data in ", arrayName);
      return false;
   }

   string data = "{";

   data += "\"command\":\"CHART-INIT\",";
   data += "\"operations\":[";

   // MAKE - only when creating a new table
   if(mode == Create)
   {
      data += "{";
      data += "\"command\":\"MAKE\",";
      data += "\"table\":\"" + arrayName + "\",";

      data += "\"columns\":";
      if(arrayName == "h1Candles")
         data += schema.H1_CANDLES_COLUMNS;
      else
         data += schema.H6_CANDLES_COLUMNS;

      data += "},";
   }

   // INSR
   data += "{";
   data += "\"command\":\"INSR\",";
   data += "\"table\":\"" + arrayName + "\",";
   data += "\"records\":[" + records + "]";
   data += "}";

   data += "]";
   data += "}";

   if(!Gateway.ExecuteRequest(data))
   {
      Print("[GATEWAY] Request execution did not complete.");
      return false;
   }

   Print("[GATEWAY] Request execution completed: ", arrayName);

   return true;
}
