void HandleCabinOrder()
{
   CJAVal order = Gateway.get_cabin_order();
   
   Print("[CABIN] ", order.Serialize());
   
   string cabinCommand = order["command"].ToStr();

   // -----------------------------------------
   // LLM-GROUP
   // -----------------------------------------
   if(cabinCommand == "LLM-GROUP")
   {

      string operation = order["operation"].ToStr();
   
      bool success = false;
   
      if(operation == "INIT")
      {
         success = InitializeLLMTables();
      }
      else if(operation == "DEBATE")
      {
         success = InitializeLLMDebate();
      }
      else if(operation == "HUMAN")
      {
         success = InitializeLLMHumanIntervention();
      }
      else
      {
         Print("[LLM-GROUP] Unknown operation: ", operation);
      }
   
      if(!Gateway.CompleteCabinCommand(
         success ? "COMPLETED" : "FAILED"
      ))
      {
         Print("[LLM-GROUP] Could not update Cabin command status.");
      }
   
      return;
   }
   
   // -----------------------------------------
   // MT5-RESEND
   // -----------------------------------------
   else if(cabinCommand == "MT5-RESEND")
   {
      string operation = order["operation"].ToStr();
      bool processed = false;
   
      if(operation == "TAKE-DATE")
      {
         string startText = order["start"].ToStr();
         string endText   = order["end"].ToStr();
   
         StringReplace(startText, "-", ".");
         StringReplace(endText, "-", ".");
   
         datetime startTime = StringToTime(startText);
         datetime endTime   = StringToTime(endText);
   
         if(startTime <= 0 || endTime <= 0 || startTime >= endTime)
         {
            Print("[MT5-RESEND] Invalid date range.");
            return;
         }
   
         if(!BuildCandleSeries(true, startTime, endTime))
         {
            Print("[MT5-RESEND] Historical candle construction failed.");
            return;
         }
   
         processed = GoSend("h1Candles", Create);
   
         if(processed && h6Candles != "")
            processed = GoSend("h6Candles", Create);
   
         if(processed)
         {
            SmallBoxRecord boxRecords[];
   
            if(!BuildSmallBoxRecords(
               true,
               startTime,
               endTime,
               boxRecords
            ))
            {
               processed = false;
            }
            else if(!SendSmallBoxRecords(boxRecords, Create))
            {
               processed = false;
            }
         }
   
         if(processed)
            LastCandle = BuiltLastCandle;
   
      }
      else if(operation == "SEND-NEXT")
      {
         if(LastCandle <= 0)
         {
            Print("[MT5-RESEND] LastCandle is not initialized.");
            return;
         }
   
         //PrintFormat(
         //   "[SEND-NEXT-DEBUG] LAST-CANDLE-BEFORE=%s",
         //   TimeToString(LastCandle, TIME_DATE|TIME_MINUTES)
         //);
   
         if(!BuildCandleSeries(false, LastCandle, 0))
         {
            Print("[MT5-RESEND] Next candle construction failed.");
            return;
         }
      
         processed = GoSend("h1Candles", Append);
      
         if(processed && h6Candles != "")
            processed = GoSend("h6Candles", Append);
      
         if(processed)
         {
            SmallBoxRecord boxRecords[];
   
            if(!BuildSmallBoxRecords(
               false,
               0,
               BuiltLastCandle,
               boxRecords
            ))
            {
               processed = false;
            }
            else if(!SendSmallBoxRecords(boxRecords, Append))
            {
               processed = false;
            }
         }
         if(processed)
         {
            //PrintFormat(
            //   "[SEND-NEXT-DEBUG] POINTER-UPDATE | OLD=%s | BUILT=%s",
            //   TimeToString(LastCandle, TIME_DATE|TIME_MINUTES),
            //   TimeToString(BuiltLastCandle, TIME_DATE|TIME_MINUTES)
            //);
         
            LastCandle = BuiltLastCandle;
         
            //PrintFormat(
            //   "[SEND-NEXT-DEBUG] LAST-CANDLE-AFTER=%s",
            //   TimeToString(LastCandle, TIME_DATE|TIME_MINUTES)
            //);
         }
      }
      else
      {
         Print("[MT5-RESEND] Unknown operation: ", operation);
         return;
      }
   
      if(processed)
      {
         Print("[MT5-RESEND] Operation completed: ", operation);
      }
      else
      {
         Print("[MT5-RESEND] Operation failed; command remains pending.");
      }
   }
}



