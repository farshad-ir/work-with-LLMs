void OnTick()
{
   datetime currentBar = iTime(_Symbol, PERIOD_H1, 0);

   if(currentBar <= 0 || currentBar == HassanLastBoxBar)
      return;

   HassanLastBoxBar = currentBar;

   int historyBars = GetHassanHistoryBars();

   if(historyBars <= 0)
      return;

   g_ma_h1.Update(historyBars);
   m_stc.Update(historyBars);

   m_fractal.Build(historyBars);

   DrawHassanSmallBoxes();
}



void OnDeinit(const int reason)
{
   CleanupHassanSmallBoxes();
}   

