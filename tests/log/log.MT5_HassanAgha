int OnInit()
{


   ////////////////////////////////
   //
   // Init for MAs and Fractals
   //
   ////////////////////////////////

   if(!g_ma_h1.Init(7, 14, PERIOD_H1))
   {
      Print("[INIT] H1 MA initialization failed.");
      return INIT_FAILED;
   }
   
   if(!g_ma_h6.Init(42, 84, PERIOD_H6))
   {
      Print("[INIT] H6 MA initialization failed.");
      return INIT_FAILED;
   }
   
      
   m_stc.Init();
   
   int historyBars = GetHassanHistoryBars();
   
   if(historyBars <= 0)
      return INIT_FAILED;
   
   m_stc.Update(historyBars);
   
   g_ma_h1.Update(historyBars);
   g_ma_h6.Update(10000);
   
   m_fractal.Set(m_stc,g_ma_h1);
   m_fractal.Build(historyBars);

   PrintFormat(
      "[HA-BOX-INIT] bars=%d | shift=%d | boxes=%d | first=%s | last=%s",
      Bars(_Symbol, PERIOD_H1),
      iBarShift(_Symbol, PERIOD_H1, HassanBoxStart, false),
      m_fractal.SmallBoxCount(),
      TimeToString(iTime(_Symbol, PERIOD_H1, Bars(_Symbol, PERIOD_H1)-1), TIME_DATE),
      TimeToString(iTime(_Symbol, PERIOD_H1, 0), TIME_DATE)
   );

   
   H1_river.Set(g_ma_h1);
   H6_river.Set(g_ma_h6);

   DrawHassanSmallBoxes();
   HassanLastBoxBar = iTime(_Symbol, PERIOD_H1, 0);







   if(!Gateway.Initialize(InpGatewayClientId, InpGatewayFolderName))
   {
      Print("[GATEWAY] Initialization failed.");
      return INIT_FAILED;
   }

   if(!EventSetTimer(30))
   {
      Print("[TIMER] Initialization failed.");
      return INIT_FAILED;
   }

   Print("[INIT] HassanAgha started.");

   return INIT_SUCCEEDED;
}
   


void OnTick()
{
   datetime currentBar = iTime(_Symbol, PERIOD_H1, 0);

   if(currentBar <= 0 || currentBar == HassanLastBoxBar)
      return;

   HassanLastBoxBar = currentBar;

   int historyBars = GetHassanHistoryBars();

   if(historyBars <= 0)
      return;

   g_ma_h1.Update(historyBars);
   m_stc.Update(historyBars);

   m_fractal.Build(historyBars);

   DrawHassanSmallBoxes();
}



void OnDeinit(const int reason)
{
   CleanupHassanSmallBoxes();
}   

