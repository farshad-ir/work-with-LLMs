bool BuildCandleSeries(
   const bool reset,
   const datetime start,
   const datetime end
)
{
   h1Candles = "";
   h6Candles = "";
   BuiltLastCandle = 0;

   if(reset && end <= 0)
      return false;

   int h1Seconds = PeriodSeconds(PERIOD_H1);
   int h6Seconds = PeriodSeconds(PERIOD_H6);

   if(h1Seconds <= 0 || h6Seconds <= 0)
      return false;

   // Refresh moving averages
   g_ma_h1.Update();
   g_ma_h6.Update();

   MqlRates h1Rates[];
   MqlRates h6Rates[];

   ArraySetAsSeries(h1Rates, true);
   ArraySetAsSeries(h6Rates, true);

   int h1Copied = 0;
   int h6Copied = 0;

   //==================================================
   // RESET: Build historical series
   //==================================================
   if(reset)
   {
      if(start <= 0 || start >= end)
         return false;

      datetime h1WarmupStart =
         start - (H1_HISTORY_CAPACITY * h1Seconds);

      datetime h6WarmupStart =
         start - (H6_HISTORY_CAPACITY * h6Seconds);

      h1Copied = CopyRates(
         _Symbol,
         PERIOD_H1,
         h1WarmupStart,
         end,
         h1Rates
      );

      h6Copied = CopyRates(
         _Symbol,
         PERIOD_H6,
         h6WarmupStart,
         end,
         h6Rates
      );

      if(h1Copied <= 0 || h6Copied <= 0)
      {
         Print("[CANDLES] Historical CopyRates failed. H1=",
               h1Copied, " H6=", h6Copied);
         return false;
      }

      // Reset calculation state
      mabif_h1.Reset();
      mabif_h6.Reset();

      // H1: oldest to newest
      for(int i = h1Copied - 1; i >= 0; i--)
      {
         datetime barStart = h1Rates[i].time;
         datetime barEnd   = barStart + h1Seconds;

         if(barEnd > end)
            continue;

         int shift = iBarShift(
            _Symbol,
            PERIOD_H1,
            barStart,
            true
         );

         if(shift < 0)
            return false;

         H1_river.Update(shift);

         int dir = mabif_h1.AddPoint(
            H1_river.Center()
         );

         // Warmup candles are calculated but not exported
         if(barStart < start)
            continue;

         if(h1Candles != "")
            h1Candles += ",";

         h1Candles += BuildCandleObject(
            h1Rates[i],
            H1_river.Center(),
            H1_river.Width(),
            dir
         );
         BuiltLastCandle = barEnd;
      }

      // H6: oldest to newest
      for(int i = h6Copied - 1; i >= 0; i--)
      {
         datetime barStart = h6Rates[i].time;
         datetime barEnd   = barStart + h6Seconds;

         if(barEnd > end)
            continue;

         int shift = iBarShift(
            _Symbol,
            PERIOD_H6,
            barStart,
            true
         );

         if(shift < 0)
            return false;

         H6_river.Update(shift);

         int dir = mabif_h6.AddPoint(
            H6_river.Center()
         );

         if(barStart < start)
            continue;

         if(h6Candles != "")
            h6Candles += ",";

         h6Candles += BuildCandleObject(
            h6Rates[i],
            H6_river.Center(),
            H6_river.Width(),
            dir
         );
      }

      return (h1Candles != "");
   }

   //==================================================
   // SEND-NEXT: Find the next available H1 candle
   //==================================================

   if(start <= 0)
      return false;

   datetime searchEnd = start + (30 * 86400);

   h1Copied = CopyRates(
      _Symbol,
      PERIOD_H1,
      start,
      searchEnd,
      h1Rates
   );


   
   //PrintFormat(
   //   "[SEND-NEXT-DEBUG] START=%s | SEARCH-END=%s | COPIED=%d",
   //   TimeToString(start, TIME_DATE|TIME_MINUTES),
   //   TimeToString(searchEnd, TIME_DATE|TIME_MINUTES),
   //   h1Copied
   //);
   
   //f(h1Copied > 0)
   //{
   //   PrintFormat(
   //      "[SEND-NEXT-DEBUG] OLDEST=%s | NEWEST=%s",
   //      TimeToString(h1Rates[h1Copied - 1].time, TIME_DATE|TIME_MINUTES),
   //      TimeToString(h1Rates[0].time, TIME_DATE|TIME_MINUTES)
   //   );
   //}

   if(h1Copied <= 0)
      return false;

   // Find the earliest available candle after LastCandle
   int h1Index = -1;

   for(int i = h1Copied - 1; i >= 0; i--)
   {
      if(h1Rates[i].time >= start)
      {
         h1Index = i;
         break;
      }
   }
   
   //PrintFormat(
   //   "[SEND-NEXT-DEBUG] SELECTED-INDEX=%d",
   //   h1Index
   //);
   
   if(h1Index >= 0)
   {
      //PrintFormat(
      //   "[SEND-NEXT-DEBUG] SELECTED-TIME=%s | TARGET-END=%s",
      //   TimeToString(h1Rates[h1Index].time, TIME_DATE|TIME_MINUTES),
      //   TimeToString(h1Rates[h1Index].time + h1Seconds, TIME_DATE|TIME_MINUTES)
      //);
   
      // Show three candles before and three candles after selection.
      for(int i = h1Index + 3; i >= h1Index - 3; i--)
      {
         if(i < 0 || i >= h1Copied)
            continue;
   
         //PrintFormat(
         //   "[SEND-NEXT-DEBUG] RATE[%d] TIME=%s | OPEN=%s | CLOSE=%s",
         //   i,
         //   TimeToString(h1Rates[i].time, TIME_DATE|TIME_MINUTES),
         //   DoubleToString(h1Rates[i].open, _Digits),
         //   DoubleToString(h1Rates[i].close, _Digits)
         //);
      }
   }


   if(h1Index < 0)
      return false;

   datetime targetEnd = h1Rates[h1Index].time + h1Seconds;

   int h1Shift = iBarShift(
      _Symbol,
      PERIOD_H1,
      h1Rates[h1Index].time,
      true
   );

   if(h1Shift < 0)
      return false;

   H1_river.Update(h1Shift);

   int h1Dir = mabif_h1.AddPoint(
      H1_river.Center()
   );

   h1Candles = BuildCandleObject(
      h1Rates[h1Index],
      H1_river.Center(),
      H1_river.Width(),
      h1Dir
   );

   BuiltLastCandle = targetEnd;

   // H6 only when this H1 candle closes on a 6-hour boundary
   MqlDateTime tm;
   TimeToStruct(targetEnd, tm);

   if(tm.hour % 6 == 0 && tm.min == 0)
   {
      h6Copied = CopyRates(
         _Symbol,
         PERIOD_H6,
         targetEnd - h6Seconds,
         targetEnd,
         h6Rates
      );

      if(h6Copied <= 0)
         return false;

      int h6Index = -1;

      for(int i = 0; i < h6Copied; i++)
      {
         if(h6Rates[i].time + h6Seconds == targetEnd)
         {
            h6Index = i;
            break;
         }
      }

      if(h6Index < 0)
         return false;

      int h6Shift = iBarShift(
         _Symbol,
         PERIOD_H6,
         h6Rates[h6Index].time,
         true
      );

      if(h6Shift < 0)
         return false;

      H6_river.Update(h6Shift);

      int h6Dir = mabif_h6.AddPoint(
         H6_river.Center()
      );

      h6Candles = BuildCandleObject(
         h6Rates[h6Index],
         H6_river.Center(),
         H6_river.Width(),
         h6Dir
      );
   }

   return (h1Candles != "");
}





void OnTimer()
{
   if(!Gateway.ProcessControl())
      Print("[CONTROL] Emergency control processing failed.");

   if(!Gateway.ResumePendingRequest()){
      double fuzul = 0;
      //Print("[GATEWAY] Pending request recovery failed.");
      fuzul += 1;
   }

   if(!Gateway.RunCommands())
      Print("[COMMANDS] Command execution failed.");

   if(Gateway.IsMT5ResendPending())
      HandleCabinOrder();
   
   Gateway.consume_cabin_flag();
}

