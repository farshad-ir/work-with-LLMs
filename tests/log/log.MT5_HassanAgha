void DrawHassanSmallBoxes()
{
   // Remove previous Hassan boxes
   for(int i = ObjectsTotal(0) - 1; i >= 0; i--)
   {
      string name = ObjectName(0, i);

      if(StringFind(name, "HA_SMALLBOX_") == 0)
         ObjectDelete(0, name);
   }

   int count = m_fractal.SmallBoxCount();
   Print("[HA-BOX-DRAW] SmallBoxCount=", count);

   for(int i = 0; i < count; i++)
   {
      FlatZone box;

      if(!m_fractal.GetSmallBox(i, box))
         continue;

      if(box.endTime < HassanBoxStart)
         continue;

      datetime drawStart = box.startTime;

      if(drawStart < HassanBoxStart)
         drawStart = HassanBoxStart;

      string name = "HA_SMALLBOX_" + IntegerToString(i);

      if(!ObjectCreate(
         0,
         name,
         OBJ_RECTANGLE,
         0,
         drawStart,
         box.highPrice,
         box.endTime,
         box.lowPrice
      ))
         continue;

      ObjectSetInteger(0, name, OBJPROP_COLOR, clrIvory);
      ObjectSetInteger(0, name, OBJPROP_STYLE, STYLE_SOLID);
      ObjectSetInteger(0, name, OBJPROP_WIDTH, 2);
      ObjectSetInteger(0, name, OBJPROP_FILL, false);
      ObjectSetInteger(0, name, OBJPROP_BACK, true);

      ObjectSetString(
         0,
         name,
         OBJPROP_TOOLTIP,
         "Hassan Small Box\n" +
         "High: " + DoubleToString(box.highPrice, _Digits) + "\n" +
         "Low: " + DoubleToString(box.lowPrice, _Digits) + "\n" +
         "Start: " + TimeToString(box.startTime, TIME_DATE|TIME_MINUTES) + "\n" +
         "End: " + TimeToString(box.endTime, TIME_DATE|TIME_MINUTES)
      );
   }

   ChartRedraw(0);
}




//+------------------------------------------------------------------+
//| Build Records for Small Boxes                                    |
//+------------------------------------------------------------------+

bool BuildSmallBoxRecords(
   const bool takeDate,
   const datetime rangeStart,
   const datetime rangeEnd,
   SmallBoxRecord &records[]
)
{
   ArrayResize(records, 0);

   int count = m_fractal.SmallBoxCount();
   int mergedCount = 0;

   for(int i = 0; i < count; i++)
   {
      FlatZone box;

      if(!m_fractal.GetSmallBox(i, box))
         continue;

      int shift = iBarShift(
         _Symbol,
         PERIOD_H1,
         box.endTime,
         false
      );

      if(shift < 3)
         continue;

      // TAKE-DATE: select boxes by their maturity time.
      if(takeDate)
      {
         datetime matureTime = iTime(
            _Symbol,
            PERIOD_H1,
            shift - 3
         );

         if(matureTime < rangeStart || matureTime > rangeEnd)
            continue;
      }
      // SEND-NEXT: only boxes reaching readiness now.
      else
      {
         if(shift != 3)
            continue;
      }

      // Merge boxes with the same EndTime.
      int found = -1;

      for(int j = 0; j < mergedCount; j++)
      {
         if(records[j].endTime == box.endTime)
         {
            found = j;
            break;
         }
      }

      if(found >= 0)
      {
         if(box.startTime < records[found].startTime)
            records[found].startTime = box.startTime;

         if(box.highPrice > records[found].highPrice)
            records[found].highPrice = box.highPrice;

         if(box.lowPrice < records[found].lowPrice)
            records[found].lowPrice = box.lowPrice;
      }
      else
      {
         int newSize = ArrayResize(records, mergedCount + 1);

         if(newSize != mergedCount + 1)
            return false;

         records[mergedCount].startTime = box.startTime;
         records[mergedCount].endTime = box.endTime;
         records[mergedCount].highPrice = box.highPrice;
         records[mergedCount].lowPrice = box.lowPrice;

         mergedCount++;
      }
   }

   PrintFormat(
      "[HA-BOX-BUILD] Found=%d | Merged=%d | TAKE-DATE=%s",
      count,
      mergedCount,
      takeDate ? "true" : "false"
   );

   return true;
}


//+------------------------------------------------------------------+
//| Send Records of Small Boxes                                    |
//+------------------------------------------------------------------+

bool SendSmallBoxRecords(
   const SmallBoxRecord &records[],
   const ENUM_CANDLE_SEND_MODE mode
)
{
   int count = ArraySize(records);

   // No data to append.
   if(mode == Append && count == 0)
   {
      Print("[HA-BOX-SEND] No new boxes to append.");
      return true;
   }

   string data = "{";
   data += "\"command\":\"CHART-INIT\",";
   data += "\"operations\":[";

   // Create mode: recreate SmallBoxes table and its unique index.
   if(mode == Create)
   {
      data += "{";
      data += "\"command\":\"MAKE\",";
      data += "\"table\":\"SmallBoxes\",";
      data += "\"columns\":[";

      data += "{\"name\":\"StartTime\",\"type\":\"TEXT\",\"not_null\":true},";
      data += "{\"name\":\"EndTime\",\"type\":\"TEXT\",\"not_null\":true},";
      data += "{\"name\":\"High\",\"type\":\"REAL\",\"not_null\":true},";
      data += "{\"name\":\"Low\",\"type\":\"REAL\",\"not_null\":true}";

      data += "],";
      data += "\"unique\":[";
      data += "{";
      data += "\"name\":\"SmallBoxes_EndTime_uq\",";
      data += "\"columns\":[\"EndTime\"]";
      data += "}";
      data += "]";
      data += "}";

      if(count > 0)
         data += ",";
   }

   // Insert records.
   if(count > 0)
   {
      data += "{";
      data += "\"command\":\"";
      data += (mode == Create ? "INSR" : "INSR-IGNORE");
      data += "\",";
      data += "\"table\":\"SmallBoxes\",";
      data += "\"records\":[";

      for(int i = 0; i < count; i++)
      {
         if(i > 0)
            data += ",";

         data += "{";

         data += "\"StartTime\":\"";
         data += TimeToString(
            records[i].startTime,
            TIME_DATE | TIME_MINUTES
         );
         data += "\",";

         data += "\"EndTime\":\"";
         data += TimeToString(
            records[i].endTime,
            TIME_DATE | TIME_MINUTES
         );
         data += "\",";

         data += "\"High\":";
         data += DoubleToString(records[i].highPrice, _Digits);
         data += ",";

         data += "\"Low\":";
         data += DoubleToString(records[i].lowPrice, _Digits);

         data += "}";
      }

      data += "]";
      data += "}";
   }

   data += "]";
   data += "}";

   if(!Gateway.ExecuteRequest(data))
   {
      Print("[HA-BOX-SEND] Gateway request failed.");
      return false;
   }

   PrintFormat(
      "[HA-BOX-SEND] Completed | Mode=%s | Records=%d",
      mode == Create ? "CREATE" : "APPEND",
      count
   );

   return true;
}



