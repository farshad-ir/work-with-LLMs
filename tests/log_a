//+------------------------------------------------------------------+
//| Bifurcation history                                               |
//+------------------------------------------------------------------+
struct BifurcationRecord
{
   datetime candleTime;
   int      direction;
};

BifurcationRecord g_h1History[HISTORY_CAPACITY];
BifurcationRecord g_h6History[HISTORY_CAPACITY];

int g_h1HistoryCount = 0;
int g_h6HistoryCount = 0;

int g_h1HistoryNext = 0;
int g_h6HistoryNext = 0;


//+------------------------------------------------------------------+
//| Runtime state                                                     |
//+------------------------------------------------------------------+
datetime g_lastH1BarTime = 0;
datetime g_lastH6BarTime = 0;

bool g_bootstrapped = false;


//+------------------------------------------------------------------+
//| Direction to text                                                 |
//+------------------------------------------------------------------+
string DirectionText(const int direction)
{
   if(direction == 1)
      return "UP";

   if(direction == -1)
      return "DOWN";

   return "UNKNOWN";
}


//+------------------------------------------------------------------+
//| Find H1 history record                                            |
//+------------------------------------------------------------------+
int FindH1Record(const datetime candleTime)
{
   for(int i = 0; i < g_h1HistoryCount; i++)
   {
      if(g_h1History[i].candleTime == candleTime)
         return i;
   }

   return -1;
}


//+------------------------------------------------------------------+
//| Find H6 history record                                            |
//+------------------------------------------------------------------+
int FindH6Record(const datetime candleTime)
{
   for(int i = 0; i < g_h6HistoryCount; i++)
   {
      if(g_h6History[i].candleTime == candleTime)
         return i;
   }

   return -1;
}


//+------------------------------------------------------------------+
//| Add H1 history record (FIFO)                                      |
//+------------------------------------------------------------------+
void AddH1Record(
   const datetime candleTime,
   const int direction
)
{
   g_h1History[g_h1HistoryNext].candleTime = candleTime;
   g_h1History[g_h1HistoryNext].direction = direction;

   g_h1HistoryNext++;

   if(g_h1HistoryNext >= HISTORY_CAPACITY)
      g_h1HistoryNext = 0;

   if(g_h1HistoryCount < HISTORY_CAPACITY)
      g_h1HistoryCount++;
}


//+------------------------------------------------------------------+
//| Add H6 history record (FIFO)                                      |
//+------------------------------------------------------------------+
void AddH6Record(
   const datetime candleTime,
   const int direction
)
{
   g_h6History[g_h6HistoryNext].candleTime = candleTime;
   g_h6History[g_h6HistoryNext].direction = direction;

   g_h6HistoryNext++;

   if(g_h6HistoryNext >= HISTORY_CAPACITY)
      g_h6HistoryNext = 0;

   if(g_h6HistoryCount < HISTORY_CAPACITY)
      g_h6HistoryCount++;
}


//+------------------------------------------------------------------+
//| Build one candle JSON                                             |
//+------------------------------------------------------------------+
string BuildCandleJson(
   const MqlRates &bar,
   const string timeframe,
   const double riverCenter,
   const double riverWidth,
   const int direction
)
{
   string timeStr = TimeToString(
      bar.time,
      TIME_DATE | TIME_MINUTES
   );

   string data = "{";

   data += "\"cover_letter\":\"From MT5 to AI\",";
   data += "\"symbol\":\"" + _Symbol + "\",";
   data += "\"timeframe\":\"" + timeframe + "\",";
   data += "\"candles\":[";

   data += "{";

   data += "\"time\":\"" + timeStr + "\",";
   data += "\"open\":" + DoubleToString(bar.open, _Digits) + ",";
   data += "\"high\":" + DoubleToString(bar.high, _Digits) + ",";
   data += "\"low\":" + DoubleToString(bar.low, _Digits) + ",";
   data += "\"close\":" + DoubleToString(bar.close, _Digits) + ",";

   data += "\"tick_volume\":" + IntegerToString((long)bar.tick_volume) + ",";
   data += "\"spread_points\":" + IntegerToString(bar.spread) + ",";

   data += "\"river_center\":" + DoubleToString(riverCenter, _Digits) + ",";
   data += "\"river_width_pips\":" + DoubleToString(riverWidth, 2) + ",";

   data += "\"ma_bifurcation\":{";
   data += "\"direction\":\"" + DirectionText(direction) + "\"";
   data += "}";

   data += "}";

   data += "]}";

   return data;
}


//+------------------------------------------------------------------+
//| Send JSON through existing DLL sender                             |
//+------------------------------------------------------------------+
void SaveSendFile(const string data)
{
   int fileH = FileOpen(
      "LLM-LQ/mt5_feed.json",
      FILE_WRITE | FILE_TXT | FILE_COMMON | FILE_UNICODE
   );

   if(fileH == INVALID_HANDLE)
   {
      Print(
         "[SENDER] FileOpen failed. Error: ",
         GetLastError()
      );

      return;
   }

   FileWriteString(fileH, data);
   FileClose(fileH);

   int result = SendLatestJson();

   Print(
      "[SENDER] SendLatestJson result: ",
      result
   );
}


//+------------------------------------------------------------------+
//| Read response from existing DLL                                   |
//+------------------------------------------------------------------+
void ReadPoling()
{
   int bytesRead = PollResponses(
      "mt5_terminal_01",
      response,
      ArraySize(response)
   );

   if(bytesRead <= 0)
      return;

   string jsonResponse = CharArrayToString(
      response,
      0,
      bytesRead,
      CP_UTF8
   );

   if(!json.Deserialize(jsonResponse, CP_UTF8))
   {
      Print("[SENDER] Could not parse response.");
      return;
   }

   if(!json["success"].ToBool())
   {
      Print("[SENDER] Response success=false");
      return;
   }

   CJAVal statistics = json["statistics"];

   Print(
      "[SENDER] Requests=",
      statistics["requests"].ToInt(),
      " Bytes=",
      statistics["bytes"].ToInt(),
      " Characters=",
      statistics["characters"].ToInt(),
      " Words=",
      statistics["words"].ToInt()
   );
}


//+------------------------------------------------------------------+
//| Send one candle                                                   |
//+------------------------------------------------------------------+
void SendOneCandle(
   const MqlRates &bar,
   const string timeframe,
   const double center,
   const double width,
   const int direction
)
{
   string data = BuildCandleJson(
      bar,
      timeframe,
      center,
      width,
      direction
   );

   Print(
      "[COLLECTOR] Sending ",
      timeframe,
      " candle: ",
      TimeToString(bar.time, TIME_DATE | TIME_MINUTES),
      " | Bifurcation=",
      DirectionText(direction)
   );

   SaveSendFile(data);

   ReadPoling();
}


//+------------------------------------------------------------------+
//| Process one H1 candle                                             |
//+------------------------------------------------------------------+
void ProcessH1Candle(
   const MqlRates &bar,
   const int shift,
   const bool send
)
{
   H1_river.Update(shift);

   int recordIndex = FindH1Record(bar.time);

   int direction;

   if(recordIndex >= 0)
   {
      // Already calculated: reuse stored result.
      direction = g_h1History[recordIndex].direction;
   }
   else
   {
      // New candle: feed exactly once.
      direction = mabif_h1.AddPoint(
         H1_river.Center()
      );

      AddH1Record(
         bar.time,
         direction
      );
   }

   PrintFormat(
      "[H1] %s | Close=%.5f | Center=%.5f | Width=%.2f | Bifurcation=%s",
      TimeToString(bar.time, TIME_DATE | TIME_MINUTES),
      bar.close,
      H1_river.Center(),
      H1_river.Width(),
      DirectionText(direction)
   );

   if(send)
   {
      SendOneCandle(
         bar,
         "H1",
         H1_river.Center(),
         H1_river.Width(),
         direction
      );
   }
}


//+------------------------------------------------------------------+
//| Process one H6 candle                                             |
//+------------------------------------------------------------------+
void ProcessH6Candle(
   const MqlRates &bar,
   const int shift,
   const bool send
)
{
   H6_river.Update(shift);

   int recordIndex = FindH6Record(bar.time);

   int direction;

   if(recordIndex >= 0)
   {
      direction = g_h6History[recordIndex].direction;
   }
   else
   {
      direction = mabif_h6.AddPoint(
         H6_river.Center()
      );

      AddH6Record(
         bar.time,
         direction
      );
   }

   PrintFormat(
      "[H6] %s | Close=%.5f | Center=%.5f | Width=%.2f | Bifurcation=%s",
      TimeToString(bar.time, TIME_DATE | TIME_MINUTES),
      bar.close,
      H6_river.Center(),
      H6_river.Width(),
      DirectionText(direction)
   );

   if(send)
   {
      SendOneCandle(
         bar,
         "H6",
         H6_river.Center(),
         H6_river.Width(),
         direction
      );
   }
}


//+------------------------------------------------------------------+
//| Initial history synchronization                                   |
//+------------------------------------------------------------------+
bool BootstrapHistory()
{
   MqlRates h1Rates[];
   MqlRates h6Rates[];

   ArraySetAsSeries(h1Rates, true);
   ArraySetAsSeries(h6Rates, true);

   int h1Copied = CopyRates(
      _Symbol,
      PERIOD_H1,
      1,
      H1_INITIAL_COUNT,
      h1Rates
   );

   int h6Copied = CopyRates(
      _Symbol,
      PERIOD_H6,
      1,
      H6_INITIAL_COUNT,
      h6Rates
   );

   if(h1Copied != H1_INITIAL_COUNT)
   {
      Print("[BOOTSTRAP] H1 history not ready: ", h1Copied);
      return false;
   }

   if(h6Copied != H6_INITIAL_COUNT)
   {
      Print("[BOOTSTRAP] H6 history not ready: ", h6Copied);
      return false;
   }

   Print("========== BOOTSTRAP START ==========");

   g_ma_h1.Update();
   g_ma_h6.Update();

   // H1: oldest to newest.
   for(int i = H1_INITIAL_COUNT - 1; i >= 0; i--)
   {
      int shift = i + 1;

      ProcessH1Candle(
         h1Rates[i],
         shift,
         true
      );
   }

   // H6: oldest to newest.
   for(int i = H6_INITIAL_COUNT - 1; i >= 0; i--)
   {
      int shift = i + 1;

      ProcessH6Candle(
         h6Rates[i],
         shift,
         true
      );
   }

   // Remember current open candle times.
   g_lastH1BarTime = iTime(
      _Symbol,
      PERIOD_H1,
      0
   );

   g_lastH6BarTime = iTime(
      _Symbol,
      PERIOD_H6,
      0
   );

   g_bootstrapped = true;

   Print(
      "========== BOOTSTRAP COMPLETE ==========",
      " H1=", g_h1HistoryCount,
      " H6=", g_h6HistoryCount
   );

   return true;
}


//+------------------------------------------------------------------+
//| Process newly closed H1 candle                                   |
//+------------------------------------------------------------------+
void CheckNewH1Candle()
{
   datetime currentBarTime = iTime(
      _Symbol,
      PERIOD_H1,
      0
   );

   if(currentBarTime == 0)
      return;

   if(currentBarTime == g_lastH1BarTime)
      return;

   MqlRates bar[];

   ArraySetAsSeries(bar, true);

   if(CopyRates(_Symbol, PERIOD_H1, 1, 1, bar) != 1)
      return;

   g_lastH1BarTime = currentBarTime;

   g_ma_h1.Update();

   ProcessH1Candle(
      bar[0],
      1,
      true
   );
}


//+------------------------------------------------------------------+
//| Process newly closed H6 candle                                   |
//+------------------------------------------------------------------+
void CheckNewH6Candle()
{
   datetime currentBarTime = iTime(
      _Symbol,
      PERIOD_H6,
      0
   );

   if(currentBarTime == 0)
      return;

   if(currentBarTime == g_lastH6BarTime)
      return;

   MqlRates bar[];

   ArraySetAsSeries(bar, true);

   if(CopyRates(_Symbol, PERIOD_H6, 1, 1, bar) != 1)
      return;

   g_lastH6BarTime = currentBarTime;

   g_ma_h6.Update();

   ProcessH6Candle(
      bar[0],
      1,
      true
   );
}


//+------------------------------------------------------------------+
//| Expert initialization                                             |
//+------------------------------------------------------------------+
int OnInit()
{
   if(!g_ma_h1.Init(7, 14, PERIOD_H1))
   {
      Print("[INIT] H1 MA initialization failed.");
      return INIT_FAILED;
   }

   if(!g_ma_h6.Init(42, 84, PERIOD_H6))
   {
      Print("[INIT] H6 MA initialization failed.");
      return INIT_FAILED;
   }

   H1_river.Set(g_ma_h1);
   H6_river.Set(g_ma_h6);

   Print("[INIT] H1/H6 collector initialized.");

   return INIT_SUCCEEDED;
}


//+------------------------------------------------------------------+
//| Expert deinitialization                                           |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   Print(
      "[STOP] Collector stopped. Reason=",
      reason
   );
}


//+------------------------------------------------------------------+
//| Expert tick                                                       |
//+------------------------------------------------------------------+
void OnTick()
{
   if(!g_bootstrapped)
   {
      BootstrapHistory();
      return;
   }

   CheckNewH1Candle();

   CheckNewH6Candle();
}

