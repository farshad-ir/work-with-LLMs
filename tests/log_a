      "INIT-" +
      IntegerToString((long)TimeCurrent()) +
      "-" +
      IntegerToString(GetTickCount());

   string data = "{";

   data += "\"message_type\":\"INIT\",";
   data += "\"message_id\":\"" + messageId + "\",";
   data += "\"symbol\":\"" + _Symbol + "\",";

   data += "\"timeframes\":{";

   data += "\"H1\":{";
   data += "\"candles\":[" + h1Candles + "]";
   data += "},";

   data += "\"H6\":{";
   data += "\"candles\":[" + h6Candles + "]";
   data += "}";

   data += "}";

   data += "}";

   return data;
}

