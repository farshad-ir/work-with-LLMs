//+------------------------------------------------------------------+
//| Initial history synchronization                                   |
//+------------------------------------------------------------------+
bool BootstrapHistory()
{
   MqlRates h1Rates[];
   MqlRates h6Rates[];

   ArraySetAsSeries(h1Rates, true);
   ArraySetAsSeries(h6Rates, true);

   int h1Copied = CopyRates(
      _Symbol,
      PERIOD_H1,
      1,
      H1_HISTORY_CAPACITY,
      h1Rates
   );

   int h6Copied = CopyRates(
      _Symbol,
      PERIOD_H6,
      1,
      H6_HISTORY_CAPACITY,
      h6Rates
   );

   if(h1Copied != H1_HISTORY_CAPACITY)
   {
      Print("[BOOTSTRAP] H1 history not ready: ", h1Copied);
      return false;
   }

   if(h6Copied != H6_HISTORY_CAPACITY)
   {
      Print("[BOOTSTRAP] H6 history not ready: ", h6Copied);
      return false;
   }

   Print("========== BOOTSTRAP START ==========");

   string h1Candles = "";
   string h6Candles = "";

   g_ma_h1.Update();
   g_ma_h6.Update();

   // H1: oldest to newest.
   for(int i = H1_HISTORY_CAPACITY - 1; i >= 0; i--)
   {
      int shift = i + 1;

      FeedH1Candle(
         h1Rates[i],
         shift
      );
      
      ProcessH1Candle(
         h1Rates[i],
         shift,
         false
      );


      int recordIndex = FindH1Record(h1Rates[i].time);

      if(recordIndex < 0)
      {
         Print("[BOOTSTRAP ERROR] H1 record missing.");
         return false;
      }

      if(StringLen(h1Candles) > 0)
         h1Candles += ",";

      h1Candles += BuildCandleObject(
         h1Rates[i],
         H1_river.Center(),
         H1_river.Width(),
         g_h1History[recordIndex].direction
      );



   }

   // H6: oldest to newest.
   for(int i = H6_HISTORY_CAPACITY - 1; i >= 0; i--)
   {
      int shift = i + 1;

      FeedH6Candle(
         h6Rates[i],
         shift
      );
      
      ProcessH6Candle(
         h6Rates[i],
         shift,
         false
      );



      int recordIndex = FindH6Record(h6Rates[i].time);

      if(recordIndex < 0)
      {
         Print("[BOOTSTRAP ERROR] H6 record missing.");
         return false;
      }

      if(StringLen(h6Candles) > 0)
         h6Candles += ",";

      h6Candles += BuildCandleObject(
         h6Rates[i],
         H6_river.Center(),
         H6_river.Width(),
         g_h6History[recordIndex].direction
      );




   }

   string initData = BuildInitJson(
      h1Candles,
      h6Candles
   );

   Print(
      "[BOOTSTRAP] INIT prepared. H1=",
      H1_HISTORY_CAPACITY,
      " H6=",
      H6_HISTORY_CAPACITY
   );

   SaveSendFile(initData);
   ReadPoling();



   // Remember current open candle times.
   g_lastH1BarTime = iTime(
      _Symbol,
      PERIOD_H1,
      0
   );

   g_lastH6BarTime = iTime(
      _Symbol,
      PERIOD_H6,
      0
   );

   g_bootstrapped = true;

   Print(
      "========== BOOTSTRAP COMPLETE ==========",
      " H1=", g_h1HistoryCount,
      " H6=", g_h6HistoryCount
   );

   return true;
}


//+------------------------------------------------------------------+
//| Process newly closed H1 candle                                   |
//+------------------------------------------------------------------+
void CheckNewH1Candle()
{
   datetime currentBarTime = iTime(
      _Symbol,
      PERIOD_H1,
      0
   );

   if(currentBarTime == 0)
      return;

   if(currentBarTime == g_lastH1BarTime)
      return;

   MqlRates bar[];

   ArraySetAsSeries(bar, true);

   if(CopyRates(_Symbol, PERIOD_H1, 1, 1, bar) != 1)
      return;

   g_lastH1BarTime = currentBarTime;

   g_ma_h1.Update();

   FeedH1Candle(
      bar[0],
      1
   );

   ProcessH1Candle(
      bar[0],
      1,
      true
   );
}


//+------------------------------------------------------------------+
//| Process newly closed H6 candle                                   |
//+------------------------------------------------------------------+
void CheckNewH6Candle()
{
   datetime currentBarTime = iTime(
      _Symbol,
      PERIOD_H6,
      0
   );

   if(currentBarTime == 0)
      return;

   if(currentBarTime == g_lastH6BarTime)
      return;

   MqlRates bar[];

   ArraySetAsSeries(bar, true);

   if(CopyRates(_Symbol, PERIOD_H6, 1, 1, bar) != 1)
      return;

   g_lastH6BarTime = currentBarTime;

   g_ma_h6.Update();

   FeedH6Candle(
      bar[0],
      1
   );

   ProcessH6Candle(
      bar[0],
      1,
      true
   );
}


//+------------------------------------------------------------------+
//| Expert initialization                                             |
//+------------------------------------------------------------------+
int OnInit()
{
   if(!g_ma_h1.Init(7, 14, PERIOD_H1))
   {
      Print("[INIT] H1 MA initialization failed.");
      return INIT_FAILED;
   }

   if(!g_ma_h6.Init(42, 84, PERIOD_H6))
   {
      Print("[INIT] H6 MA initialization failed.");
      return INIT_FAILED;
   }

   H1_river.Set(g_ma_h1);
   H6_river.Set(g_ma_h6);

   if(!BootstrapHistory())
   {
      Print("[INIT] Initial history bootstrap failed.");
      return INIT_FAILED;
   }

   Print("[INIT] H1/H6 collector initialized.");

   return INIT_SUCCEEDED;
}


//+------------------------------------------------------------------+
//| Expert deinitialization                                           |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
{
   Print(
      "[STOP] Collector stopped. Reason=",
      reason
   );
}


//+------------------------------------------------------------------+
//| Expert tick                                                       |
//+------------------------------------------------------------------+
void OnTick()
{
   CheckNewH1Candle();

   CheckNewH6Candle();
}


