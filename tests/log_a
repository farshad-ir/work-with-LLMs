//+------------------------------------------------------------------+
//| Bifurcation history                                               |
//+------------------------------------------------------------------+
struct BifurcationRecord
{
   datetime candleTime;
   int      direction;
};

BifurcationRecord g_h1History[H1_HISTORY_CAPACITY];
BifurcationRecord g_h6History[H6_HISTORY_CAPACITY];

int g_h1HistoryCount = 0;
int g_h6HistoryCount = 0;

int g_h1HistoryNext = 0;
int g_h6HistoryNext = 0;


//+------------------------------------------------------------------+
//| Runtime state                                                     |
//+------------------------------------------------------------------+
datetime g_lastH1BarTime = 0;
datetime g_lastH6BarTime = 0;

bool g_bootstrapped = false;


//+------------------------------------------------------------------+
//| Direction to text                                                 |
//+------------------------------------------------------------------+
string DirectionText(const int direction)
{
   if(direction == 1)
      return "UP";

   if(direction == -1)
      return "DOWN";

   return "UNKNOWN";
}


//+------------------------------------------------------------------+
//| Find H1 history record                                            |
//+------------------------------------------------------------------+
int FindH1Record(const datetime candleTime)
{
   for(int i = 0; i < g_h1HistoryCount; i++)
   {
      if(g_h1History[i].candleTime == candleTime)
         return i;
   }

   return -1;
}


//+------------------------------------------------------------------+
//| Find H6 history record                                            |
//+------------------------------------------------------------------+
int FindH6Record(const datetime candleTime)
{
   for(int i = 0; i < g_h6HistoryCount; i++)
   {
      if(g_h6History[i].candleTime == candleTime)
         return i;
   }

   return -1;
}


//+------------------------------------------------------------------+
//| Add H1 history record (FIFO)                                      |
//+------------------------------------------------------------------+
void AddH1Record(
   const datetime candleTime,
   const int direction
)
{
   g_h1History[g_h1HistoryNext].candleTime = candleTime;
   g_h1History[g_h1HistoryNext].direction = direction;

   g_h1HistoryNext++;

   if(g_h1HistoryNext >= H1_HISTORY_CAPACITY)
      g_h1HistoryNext = 0;

   if(g_h1HistoryCount < H1_HISTORY_CAPACITY)
      g_h1HistoryCount++;
}


//+------------------------------------------------------------------+
//| Add H6 history record (FIFO)                                      |
//+------------------------------------------------------------------+
void AddH6Record(
   const datetime candleTime,
   const int direction
)
{
   g_h6History[g_h6HistoryNext].candleTime = candleTime;
   g_h6History[g_h6HistoryNext].direction = direction;

   g_h6HistoryNext++;

   
   if(g_h6HistoryNext >= H6_HISTORY_CAPACITY)
      g_h6HistoryNext = 0;

   if(g_h6HistoryCount < H6_HISTORY_CAPACITY)
      g_h6HistoryCount++;

}


//+------------------------------------------------------------------+
//| Feed H1 Bifurcation exactly once                                 |
//+------------------------------------------------------------------+
void FeedH1Candle(
   const MqlRates &bar,
   const int shift
)
{
   if(FindH1Record(bar.time) >= 0)
      return;

   H1_river.Update(shift);

   int direction = mabif_h1.AddPoint(
      H1_river.Center()
   );

   AddH1Record(
      bar.time,
      direction
   );

   Print(
      "[H1 FEED] ",
      TimeToString(bar.time, TIME_DATE | TIME_MINUTES),
      " | ",
      DirectionText(direction)
   );
}


//+------------------------------------------------------------------+
//| Feed H6 Bifurcation exactly once                                 |
//+------------------------------------------------------------------+
void FeedH6Candle(
   const MqlRates &bar,
   const int shift
)
{
   if(FindH6Record(bar.time) >= 0)
      return;

   H6_river.Update(shift);

   int direction = mabif_h6.AddPoint(
      H6_river.Center()
   );

   AddH6Record(
      bar.time,
      direction
   );

   Print(
      "[H6 FEED] ",
      TimeToString(bar.time, TIME_DATE | TIME_MINUTES),
      " | ",
      DirectionText(direction)
   );
}

//+------------------------------------------------------------------+
//| Build one candle JSON object                                     |
//+------------------------------------------------------------------+
string BuildCandleObject(
   const MqlRates &bar,
   const double riverCenter,
   const double riverWidth,
   const int direction
)
{
   string timeStr = TimeToString(
      bar.time,
      TIME_DATE | TIME_MINUTES
   );

   string data = "{";

   data += "\"time\":\"" + timeStr + "\",";
   data += "\"open\":" + DoubleToString(bar.open, _Digits) + ",";
   data += "\"high\":" + DoubleToString(bar.high, _Digits) + ",";
   data += "\"low\":" + DoubleToString(bar.low, _Digits) + ",";
   data += "\"close\":" + DoubleToString(bar.close, _Digits) + ",";

   data += "\"tick_volume\":" + IntegerToString((long)bar.tick_volume) + ",";
   data += "\"spread_points\":" + IntegerToString(bar.spread) + ",";

   data += "\"river_center\":" + DoubleToString(riverCenter, _Digits) + ",";
   data += "\"river_width_pips\":" + DoubleToString(riverWidth, 2) + ",";

   data += "\"ma_bifurcation\":{";
   data += "\"direction\":\"" + DirectionText(direction) + "\"";
   data += "}";

   data += "}";

   return data;
}

//+------------------------------------------------------------------+
//| Build INIT JSON with H1 and H6 candle arrays                     |
//+------------------------------------------------------------------+
string BuildInitJson(
   const string h1Candles,
   const string h6Candles
)
{
   string messageId =
      "INIT-" +
      IntegerToString((long)TimeCurrent()) +
      "-" +
      IntegerToString(GetTickCount());

   string data = "{";

   data += "\"message_type\":\"INIT\",";
   data += "\"message_id\":\"" + messageId + "\",";
   data += "\"symbol\":\"" + _Symbol + "\",";

   data += "\"timeframes\":{";

   data += "\"H1\":{";
   data += "\"candles\":[" + h1Candles + "]";
   data += "},";

   data += "\"H6\":{";
   data += "\"candles\":[" + h6Candles + "]";
   data += "}";

   data += "}";

   data += "}";

   return data;
}

//+------------------------------------------------------------------+
//| Build one candle JSON                                             |
//+------------------------------------------------------------------+
string BuildCandleJson(
   const MqlRates &bar,
   const string timeframe,
   const double riverCenter,
   const double riverWidth,
   const int direction
)
{
   string timeStr = TimeToString(
      bar.time,
      TIME_DATE | TIME_MINUTES
   );

   string data = "{";

   data += "\"cover_letter\":\"From MT5 to AI\",";
   data += "\"symbol\":\"" + _Symbol + "\",";
   data += "\"timeframe\":\"" + timeframe + "\",";
   data += "\"candles\":[";

   data += "{";

   data += "\"time\":\"" + timeStr + "\",";
   data += "\"open\":" + DoubleToString(bar.open, _Digits) + ",";
   data += "\"high\":" + DoubleToString(bar.high, _Digits) + ",";
   data += "\"low\":" + DoubleToString(bar.low, _Digits) + ",";
   data += "\"close\":" + DoubleToString(bar.close, _Digits) + ",";

   data += "\"tick_volume\":" + IntegerToString((long)bar.tick_volume) + ",";
   data += "\"spread_points\":" + IntegerToString(bar.spread) + ",";

   data += "\"river_center\":" + DoubleToString(riverCenter, _Digits) + ",";
   data += "\"river_width_pips\":" + DoubleToString(riverWidth, 2) + ",";

   data += "\"ma_bifurcation\":{";
   data += "\"direction\":\"" + DirectionText(direction) + "\"";
   data += "}";

   data += "}";

   data += "]}";

   return data;
}


//+------------------------------------------------------------------+
//| Send JSON through existing DLL sender                             |
//+------------------------------------------------------------------+
void SaveSendFile(const string data)
{
   int fileH = FileOpen(
      "LLM-LQ/mt5_feed.json",
      FILE_WRITE | FILE_TXT | FILE_COMMON | FILE_UNICODE
   );

   if(fileH == INVALID_HANDLE)
   {
      Print(
         "[SENDER] FileOpen failed. Error: ",
         GetLastError()
      );

      return;
   }

   FileWriteString(fileH, data);
   FileClose(fileH);

   int result = SendLatestJson();

   Print(
      "[SENDER] SendLatestJson result: ",
      result
   );
}


//+------------------------------------------------------------------+
//| Read response from existing DLL                                   |
//+------------------------------------------------------------------+
void ReadPoling()
{
   int bytesRead = PollResponses(
      "mt5_terminal_01",
      response,
      ArraySize(response)
   );

   if(bytesRead <= 0)
      return;

   string jsonResponse = CharArrayToString(
      response,
      0,
      bytesRead,
      CP_UTF8
   );

   if(!json.Deserialize(jsonResponse, CP_UTF8))
   {
      Print("[SENDER] Could not parse response.");
      return;
   }

   if(!json["success"].ToBool())
   {
      Print("[SENDER] Response success=false");
      return;
   }

   CJAVal statistics = json["statistics"];

   Print(
      "[SENDER] Requests=",
      statistics["requests"].ToInt(),
      " Bytes=",
      statistics["bytes"].ToInt(),
      " Characters=",
      statistics["characters"].ToInt(),
      " Words=",
      statistics["words"].ToInt()
   );
}


//+------------------------------------------------------------------+
//| Send one candle                                                   |
//+------------------------------------------------------------------+
void SendOneCandle(
   const MqlRates &bar,
   const string timeframe,
   const double center,
   const double width,
   const int direction
)
{
   string data = BuildCandleJson(
      bar,
      timeframe,
      center,
      width,
      direction
   );

   Print(
      "[COLLECTOR] Sending ",
      timeframe,
      " candle: ",
      TimeToString(bar.time, TIME_DATE | TIME_MINUTES),
      " | Bifurcation=",
      DirectionText(direction)
   );

   SaveSendFile(data);

   ReadPoling();
}


//+------------------------------------------------------------------+
//| Process one H1 candle                                             |
//+------------------------------------------------------------------+

void ProcessH1Candle(
   const MqlRates &bar,
   const int shift,
   const bool send
)
{
   H1_river.Update(shift);

   int recordIndex = FindH1Record(bar.time);

   if(recordIndex < 0)
   {
      Print(
         "[H1 ERROR] Bifurcation record not found: ",
         TimeToString(bar.time, TIME_DATE | TIME_MINUTES)
      );
      return;
   }

   int direction = g_h1History[recordIndex].direction;

   PrintFormat(
      "[H1] %s | Close=%.5f | Center=%.5f | Width=%.2f | Bifurcation=%s",
      TimeToString(bar.time, TIME_DATE | TIME_MINUTES),
      bar.close,
      H1_river.Center(),
      H1_river.Width(),
      DirectionText(direction)
   );

   if(send)
   {
      SendOneCandle(
         bar,
         "H1",
         H1_river.Center(),
         H1_river.Width(),
         direction
      );
   }
}

